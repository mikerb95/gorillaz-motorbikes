<%- include('../partials/head') %>
<%#
  LANDING DEL CLUB: "COSE TU CHALECO"
  Extiende el lenguaje "Taller a la vista" de la home. La pieza central es la
  espalda de un chaleco de club: empieza con los parches marcados con tiza y,
  al bajar por la página, recibe los puntos, el nivel y las insignias reales
  del sistema (helpers/club/lib.js y la configuración de puntos del admin).

  Todo lo de este marcado es el estado final y legible. El motion
  (public/js/club/landing.mjs) solo lo realza; si falla, devuelve lo que
  escondió (contrato fail-open de public/js/motion/core.mjs).
%>
<%
  const fmt = (n) => Number(n || 0).toLocaleString('es-CO');
  const P = puntos.points;
  const earn = [
    { key: 'rodada',        icon: 'route',  pts: P.rodada,        title: 'Rodadas del club',        how: 'Te confirman la asistencia con el QR de tu credencial al llegar.' },
    { key: 'encuentro',     icon: 'flag',   pts: P.encuentro,     title: 'Encuentros y actividades', how: 'Caminatas, encuentros y actividades del club, también con tu credencial.' },
    { key: 'mantenimiento', icon: 'wrench', pts: P.mantenimiento, title: 'Servicios en el taller',  how: 'Se suman solos cuando el taller te entrega la moto registrada en tu garaje.' },
    { key: 'visita',        icon: 'pin',    pts: P.visita,        title: 'Visitas al taller',       how: 'Muestra tu credencial en el mostrador. Una por día.' },
  ].filter(e => Number(e.pts) > 0);
  // Recorrido de ejemplo del contador: suma acumulada de las actividades.
  let acc = 0;
  const earnSteps = earn.map(e => (acc += Number(e.pts)));
  const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  const DIAS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  const evDate = (ymd) => {
    const d = new Date(String(ymd).slice(0, 10) + 'T12:00:00Z');
    return isNaN(d) ? { day: '', mon: '', wd: '' } : { day: d.getUTCDate(), mon: MESES[d.getUTCMonth()], wd: DIAS[d.getUTCDay()] };
  };
  const typeName = { rodada: 'Rodada', encuentro: 'Encuentro', caminata: 'Caminata', actividad: 'Actividad', evento: 'Evento' };
  const first = levels[0] || { name: 'Prospecto', color: '#6b7280' };
  const anyBenefits = levels.some(l => l.benefits && l.benefits.length);
  const next = events[0];
%>

<div class="clb" data-club="landing">

  <!-- ═══ Escenario: el chaleco queda fijo (escritorio) mientras pasan los pasos ═══ -->
  <div class="clb-stage">

    <div class="clb-vest-col">
      <figure class="clb-vest" data-vest-stage>
        <%- include('../partials/club/vest', {
          vid: 'lv', badges: badges.map(b => ({ ...b, earned: true })),
          levelName: first.name, levelColor: first.color || '#6b7280', bottomText: 'Bogotá',
        }) %>
        <figcaption class="clb-vest-caption">Así se ve un chaleco con todas las insignias del club.</figcaption>
      </figure>
    </div>

    <div class="clb-steps">

      <section class="clb-hero" aria-labelledby="clb-title" data-step="hero">
        <h1 id="clb-title" class="clb-h1">Rueda con la manada. Cose tu chaleco.</h1>
        <p class="clb-lead">El club de Gorillaz Motorbikes es gratis. Sumas puntos en cada rodada, en cada encuentro y en cada servicio del taller, subes de nivel y ganas insignias que se cosen en tu chaleco.</p>
        <div class="btn-row">
          <a class="btn" href="/club/registro">Unirme gratis</a>
          <a class="btn btn-outline" href="/club/login">Ya tengo cuenta</a>
        </div>
        <% if (next) { const d = evDate(next.date); %>
          <a class="clb-next" href="/eventos">
            <span class="clb-next-date"><strong><%= d.day %></strong><%= d.mon %></span>
            <span>Próxima <%= (typeName[next.type] || 'actividad').toLowerCase() %>: <strong><%= next.title %></strong><% if (next.location) { %><br><span class="clb-muted"><%= next.location %></span><% } %></span>
          </a>
        <% } %>
      </section>

      <section class="clb-step" aria-labelledby="clb-earn-title" data-step="earn" data-steps='<%- JSON.stringify(earnSteps) %>'>
        <h2 id="clb-earn-title" class="clb-h2">Cada salida suma</h2>
        <p class="clb-lead">Los puntos los registra el taller, no tú: no hay formularios que llenar ni fotos que subir.</p>
        <ol class="clb-earn">
          <% earn.forEach((e, i) => { %>
            <li data-earn="<%= i %>">
              <span class="clb-earn-pts">+<%= e.pts %></span>
              <span class="clb-earn-body"><strong><%= e.title %></strong><span><%= e.how %></span></span>
            </li>
          <% }) %>
        </ol>
      </section>

      <section class="clb-step" aria-labelledby="clb-levels-title" data-step="levels">
        <h2 id="clb-levels-title" class="clb-h2">Tu nivel va en la espalda</h2>
        <p class="clb-lead">Los puntos no vencen. Cada nivel se borda en tu chaleco y en tu credencial.</p>
        <ol class="clb-levels">
          <% levels.forEach((l, i) => { const nx = levels[i + 1]; %>
            <li data-level="<%= i %>" data-name="<%= l.name %>" data-color="<%= l.color || '#6b7280' %>" style="--lvl: <%= l.color || '#6b7280' %>">
              <span class="clb-level-dot" aria-hidden="true"></span>
              <span class="clb-level-name"><%= l.name %></span>
              <span class="clb-level-pts"><%= nx ? `${fmt(l.min)} a ${fmt(nx.min - 1)} pts` : `${fmt(l.min)} pts o más` %></span>
              <% if (l.benefits && l.benefits.length) { %>
                <ul class="clb-level-benefits"><% l.benefits.forEach(b => { %><li><%= b %></li><% }) %></ul>
              <% } %>
            </li>
          <% }) %>
        </ol>
        <% if (!anyBenefits) { %>
          <p class="clb-note">Los beneficios de cada nivel los anuncia el taller. Cuando estén definidos, aparecerán aquí.</p>
        <% } %>
      </section>

      <section class="clb-step" aria-labelledby="clb-badges-title" data-step="badges">
        <h2 id="clb-badges-title" class="clb-h2">Insignias que se ganan rodando</h2>
        <p class="clb-lead">Cada una se cose cuando cumples lo que pide. Ninguna se compra.</p>
        <ul class="clb-badges">
          <% badges.forEach((b, i) => { %>
            <li data-badge-row="<%= b.id %>">
              <svg class="clb-badge-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#lv-i-<%= b.icon %>" /></svg>
              <span><strong><%= b.name %></strong><span><%= b.desc %></span></span>
            </li>
          <% }) %>
        </ul>
      </section>

    </div>
  </div>

  <!-- ═══ Próximas salidas (datos reales) ═══ -->
  <section class="clb-band clb-events" aria-labelledby="clb-events-title">
    <div class="clb-wrap">
      <h2 id="clb-events-title" class="clb-h2">Próximas salidas</h2>
      <% if (!events.length) { %>
        <p class="clb-lead">No hay salidas programadas todavía. Las nuevas se publican en <a class="lp-link" href="/eventos">eventos</a>.</p>
      <% } else { %>
        <ul class="clb-event-list">
          <% events.forEach(ev => { const d = evDate(ev.date); %>
            <li class="clb-event" data-type="<%= ev.type %>">
              <span class="clb-event-date" aria-hidden="true"><span><%= d.wd %></span><strong><%= d.day %></strong><span><%= d.mon %></span></span>
              <span class="clb-event-body">
                <span class="clb-event-type"><%= typeName[ev.type] || 'Evento' %><% if (P[ev.type]) { %>, +<%= P[ev.type] %> pts<% } %></span>
                <strong class="clb-event-title"><%= ev.title %></strong>
                <span class="sr-only"><%= d.wd %> <%= d.day %> de <%= d.mon %>.</span>
                <% if (ev.location) { %><span class="clb-muted"><%= ev.location %></span><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
        <p><a class="lp-link" href="/eventos">Ver todos los eventos</a></p>
      <% } %>
    </div>
  </section>

  <!-- ═══ Lo que trae la cuenta ═══ -->
  <section class="clb-band clb-tools" aria-labelledby="clb-tools-title">
    <div class="clb-wrap clb-tools-grid">
      <div>
        <h2 id="clb-tools-title" class="clb-h2">Tu credencial y tu garaje</h2>
        <ul class="clb-tools-list">
          <li><strong>Credencial con QR.</strong> La muestras en la rodada o en el mostrador y los puntos quedan en el momento.</li>
          <li><strong>Garaje.</strong> Tus motos con el historial de servicios del taller y el estado de la que esté en reparación.</li>
          <li><strong>SOAT y tecnomecánica.</strong> Anotas las fechas y el panel te avisa cuando falta un mes o ya vencieron.</li>
          <li><strong>Reto del mes.</strong> Un objetivo nuevo cada mes y una racha que cuenta los meses seguidos que sales.</li>
        </ul>
      </div>
      <figure class="clb-card-demo">
        <div class="cl-cred" style="--lvl: #0891b2">
          <span class="cl-cred-club">Club Gorillaz</span>
          <span class="cl-cred-name">Tu apodo</span>
          <span class="cl-cred-level">Rider</span>
          <span class="cl-cred-code">GZ·7K3P9Q</span>
          <span class="cl-cred-qr" aria-hidden="true">
            <svg viewBox="0 0 21 21"><path d="M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0zM2 2v3h3V2zM16 2v3h3V2zM2 16v3h3v-3zM9 1h2v2H9zM9 5h3v2H9zM8 9h2v3H8zM12 8h2v2h-2zM15 9h3v2h-3zM10 13h3v2h-3zM14 13h2v3h-2zM17 15h3v2h-3zM9 17h2v3H9zM13 18h3v2h-3zM19 19h2v2h-2zM1 9h3v2H1zM5 10h2v2H5z" /></svg>
          </span>
        </div>
        <figcaption><span class="lp-example-tag">Ejemplo ilustrativo</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ Preguntas ═══ -->
  <section class="clb-band clb-faq" aria-labelledby="clb-faq-title">
    <div class="clb-wrap clb-faq-grid">
      <h2 id="clb-faq-title" class="clb-h2">Preguntas</h2>
      <div>
        <% [
          ['¿Cuánto cuesta?', 'Nada. El club es gratis y no pide tarjeta.'],
          ['¿Cómo se registran mis puntos?', 'Las rodadas, encuentros y visitas se confirman con el QR de tu credencial. Los servicios del taller suman solos cuando te entregan una moto que esté en tu garaje.'],
          ['¿Los puntos vencen?', 'No. Quedan en tu perfil.'],
          ['¿Qué gano en cada nivel?', anyBenefits ? 'Lo ves arriba, en la lista de niveles.' : 'Los beneficios de cada nivel los anuncia el taller; cuando estén definidos aparecen en esta página y en tu panel.'],
          ['¿Hay requisitos?', 'Ser mayor de edad. Recomendamos experiencia básica de conducción para las rodadas.'],
        ].forEach(([q, a]) => { %>
          <details class="clb-faq-item">
            <summary><%= q %></summary>
            <p><%= a %></p>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ═══ Cierre ═══ -->
  <section class="clb-band clb-cta" aria-labelledby="clb-cta-title">
    <div class="clb-wrap">
      <h2 id="clb-cta-title" class="clb-h2">Tu chaleco empieza vacío</h2>
      <p class="clb-lead">Crea tu cuenta, agrega tu moto y la primera rodada ya cuenta.</p>
      <div class="btn-row">
        <a class="btn" href="/club/registro">Unirme gratis</a>
        <a class="btn btn-outline" href="/club/tabla">Ver la tabla de posiciones</a>
      </div>
    </div>
  </section>

</div>

<%# GSAP vendorizado (npm run vendor:gsap); defer + module se ejecutan en orden. %>
<script defer src="/static/vendor/gsap-3.15.0/gsap.min.js"></script>
<script defer src="/static/vendor/gsap-3.15.0/ScrollTrigger.min.js"></script>
<script type="module" src="/static/js/club/landing.mjs?v=<%= assetV('js/club/landing.mjs') %>"></script>

<%- include('../partials/footer') %>
