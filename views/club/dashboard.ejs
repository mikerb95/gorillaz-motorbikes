<%- include('../partials/head', { user, extraCss: ['/static/css/taller-base.css?v=' + assetV('css/taller-base.css'), '/static/css/club.css?v=' + assetV('css/club.css')] }) %>
<%#
  PANEL DEL MIEMBRO (/club/panel)
  Cuatro pestañas: Inicio (credencial, lo que pide acción, reto y racha),
  Garaje (motos, documentos, historial del taller), Club (chaleco con las
  insignias, niveles, posición, salidas, puntos) y Cuenta.
  Sin JS se ven las cuatro seguidas; public/js/club/panel.mjs las convierte en
  pestañas por hash (#garaje, #club…) y anima la credencial y el chaleco.
  Los datos salen de helpers/club/panel-data.js.
%>
<%
  const fmt = (n) => Number(n || 0).toLocaleString('es-CO');
  const display = user.nickname || user.firstName || user.name;
  const lvl = progress.current || { name: 'Prospecto', color: '#6b7280' };
  const nxt = progress.next;
  const conceptName = { rodada: 'Rodada', encuentro: 'Encuentro', caminata: 'Caminata', actividad: 'Actividad', evento: 'Evento', mantenimiento: 'Servicio', visita: 'Visita', compra: 'Compra' };
  const typeName = { rodada: 'Rodada', encuentro: 'Encuentro', caminata: 'Caminata', actividad: 'Actividad', evento: 'Evento' };
  const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  const DIAS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  const dd = (ymd) => { const d = new Date(String(ymd).slice(0, 10) + 'T12:00:00Z'); return isNaN(d) ? { day: '', mon: '', wd: '' } : { day: d.getUTCDate(), mon: MESES[d.getUTCMonth()], wd: DIAS[d.getUTCDay()] }; };
  const shortDate = (ymd) => { const d = dd(ymd); return d.day ? `${d.day} ${d.mon}` : ''; };
  const pts = puntos.points;
  const hasPassword = user.password && user.password !== '$google$' && user.password !== '$apple$';
  const monthName = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'][Number(today.slice(5, 7)) - 1];
  const myRow = { id: user.id, name: user.name, nickname: user.nickname, score: user.score || 0, me: true };
  const board = [...neighbors.above, myRow, ...neighbors.below];
  const firstRank = rank ? rank - neighbors.above.length : null;
%>

<div class="clp" data-club="panel">

  <!-- ═══ Cabecera: credencial y meta del siguiente nivel ═══ -->
  <header class="clp-head">
    <div class="clp-wrap">
      <div class="clp-hello">
        <h1 class="clp-h1">Hola, <%= display %></h1>
        <p class="clp-sub">
          <% if (rank) { %>Puesto <strong><%= rank %></strong> en el club. <% } %>
          <% if (streak.months > 0) { %><%= streak.months %> <%= streak.months === 1 ? 'mes' : 'meses' %> seguidos con actividad.<% } %>
        </p>
        <% if (user.role === 'admin') { %><a class="clp-admin" href="/admin">Ir al panel admin</a><% } %>
      </div>

      <div class="clp-head-grid">
        <button class="clp-cred" type="button" data-cred aria-pressed="false" aria-label="Credencial del club. Toca para ver el código QR">
          <span class="clp-cred-face clp-cred-front cl-cred" style="--lvl: <%= lvl.color || '#F25C05' %>">
            <span class="cl-cred-club">Club Gorillaz</span>
            <span class="cl-cred-name"><%= display %></span>
            <span class="cl-cred-level"><%= lvl.name %></span>
            <span class="cl-cred-code"><%= memberCode ? memberCode.slice(0, 2) + '·' + memberCode.slice(2) : '' %></span>
            <span class="clp-cred-hint" aria-hidden="true">Toca para ver tu QR</span>
          </span>
          <span class="clp-cred-face clp-cred-back">
            <% if (memberCode) { %>
              <img src="/club/credencial/qr.svg" alt="Código QR de tu credencial <%= memberCode %>" width="150" height="150" loading="lazy" />
              <span class="clp-cred-back-text"><strong><%= memberCode %></strong>Muéstralo en la rodada o en el mostrador para sumar tus puntos.</span>
            <% } else { %>
              <span class="clp-cred-back-text">No se pudo generar tu código. Recarga la página.</span>
            <% } %>
          </span>
        </button>

        <div class="clp-goal" style="--lvl: <%= lvl.color || '#F25C05' %>">
          <p class="clp-goal-pts"><span class="clp-odo" data-odo="<%= user.score || 0 %>"><%= fmt(user.score) %></span> pts</p>
          <% if (nxt) { %>
            <p class="clp-goal-text">Te faltan <strong><%= fmt(progress.remaining) %> pts</strong> para <strong><%= nxt.name %></strong>.</p>
            <div class="clp-bar" role="progressbar" aria-valuemin="<%= lvl.min %>" aria-valuemax="<%= nxt.min %>" aria-valuenow="<%= user.score || 0 %>" aria-label="Progreso hacia <%= nxt.name %>">
              <span class="clp-bar-fill" data-m style="width: <%= progress.pct %>%"></span>
            </div>
            <p class="clp-bar-legend"><span><%= lvl.name %>, <%= fmt(lvl.min) %></span><span><%= nxt.name %>, <%= fmt(nxt.min) %></span></p>
            <p class="clp-goal-hint">Una rodada suma <%= pts.rodada %> pts y cada servicio en el taller <%= pts.mantenimiento %>.</p>
          <% } else { %>
            <p class="clp-goal-text">Llegaste al nivel más alto del club: <strong><%= lvl.name %></strong>.</p>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ Pestañas ═══ -->
  <nav class="clp-tabs" aria-label="Secciones del panel">
    <div class="clp-wrap clp-tabs-row">
      <a href="#inicio" data-tab="inicio">Inicio</a>
      <a href="#garaje" data-tab="garaje">Garaje<% if (alerts.some(a => a.kind !== 'order')) { %><span class="clp-dot" aria-label="con avisos"></span><% } %></a>
      <a href="#club" data-tab="club">Club</a>
      <a href="#cuenta" data-tab="cuenta">Cuenta</a>
    </div>
  </nav>

  <div class="clp-wrap clp-body">

    <!-- ═══ Inicio ═══ -->
    <section id="inicio" class="clp-panel" data-panel="inicio" aria-labelledby="t-inicio">
      <h2 id="t-inicio" class="sr-only">Inicio</h2>

      <% if (alerts.length) { %>
        <ul class="clp-alerts" aria-label="Pendientes">
          <% alerts.forEach(a => { %>
            <li class="clp-alert" data-tone="<%= a.tone %>">
              <span class="clp-alert-text"><%= a.title %></span>
              <% if (a.kind === 'order') { %>
                <a class="clp-alert-act" href="#garaje" data-tab-link="garaje">Ver la orden</a>
              <% } else if (a.kind === 'tecno') { %>
                <a class="clp-alert-act" href="/servicios/agendar">Agendar revisión</a>
              <% } else { %>
                <a class="clp-alert-act" href="#garaje" data-tab-link="garaje">Actualizar fecha</a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <div class="clp-trio">
        <article class="clp-tile">
          <h3 class="clp-h3">Reto de <%= monthName %></h3>
          <p class="clp-tile-big"><%= challenge.title %></p>
          <p class="clp-muted"><%= challenge.desc %></p>
          <div class="clp-ticks" aria-label="<%= challenge.value %> de <%= challenge.goal %>">
            <% for (let i = 0; i < challenge.goal; i++) { %><span class="<%= i < challenge.value ? 'on' : '' %>"></span><% } %>
          </div>
          <p class="clp-tile-foot"><%= challenge.done ? 'Cumplido.' : `Quedan ${challenge.daysLeft} ${challenge.daysLeft === 1 ? 'día' : 'días'}.` %></p>
        </article>

        <article class="clp-tile">
          <h3 class="clp-h3">Racha</h3>
          <p class="clp-tile-big"><%= streak.months %> <%= streak.months === 1 ? 'mes' : 'meses' %></p>
          <p class="clp-muted">
            <% if (streak.months === 0) { %>Suma puntos este mes para empezar tu racha.
            <% } else if (!streak.currentActive) { %>Suma puntos antes de fin de mes para no perderla.
            <% } else { %>Meses seguidos en los que sumaste puntos.<% } %>
          </p>
        </article>

        <article class="clp-tile">
          <h3 class="clp-h3">Próxima salida</h3>
          <% if (nextEvent) { const d = dd(nextEvent.date); const st = registrations[nextEvent.id]; %>
            <p class="clp-tile-big"><%= nextEvent.title %></p>
            <p class="clp-muted"><%= d.wd %> <%= d.day %> de <%= d.mon %><% if (nextEvent.location) { %>. <%= nextEvent.location %><% } %></p>
            <% if (st === 'pending') { %>
              <p class="clp-tile-foot">Ya estás inscrito. Muestra tu QR al llegar.</p>
            <% } else { %>
              <form method="post" action="/club/eventos/<%= nextEvent.id %>/asistencia">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="back" value="panel" />
                <button class="btn btn-sm" type="submit">Apuntarme</button>
              </form>
            <% } %>
          <% } else { %>
            <p class="clp-muted">No hay salidas programadas. Las nuevas aparecen aquí y en <a class="lp-link" href="/eventos">eventos</a>.</p>
          <% } %>
        </article>
      </div>

      <div class="clp-split">
        <section class="clp-block" aria-labelledby="t-recent">
          <h3 id="t-recent" class="clp-h3">Últimos puntos</h3>
          <% if (!history.length) { %>
            <p class="clp-muted">Todavía no tienes puntos. La primera rodada suma <%= pts.rodada %> y el primer servicio en el taller, <%= pts.mantenimiento %>.</p>
          <% } else { %>
            <ul class="clp-ledger">
              <% history.slice(0, 5).forEach(h => { %>
                <li><span class="clp-ledger-date"><%= shortDate(h.date) %></span><span><%= h.description || conceptName[h.concept] || 'Actividad' %></span><strong>+<%= h.points %></strong></li>
              <% }) %>
            </ul>
            <a class="lp-link" href="#club" data-tab-link="club">Ver todo el historial</a>
          <% } %>
        </section>
        <section class="clp-block" aria-labelledby="t-shortcuts">
          <h3 id="t-shortcuts" class="clp-h3">Atajos</h3>
          <ul class="clp-shortcuts">
            <li><a href="/servicios/agendar">Agendar servicio</a></li>
            <li><a href="/eventos">Eventos</a></li>
            <li><a href="/clasificados/mios">Mis clasificados</a></li>
            <li><a href="/tienda">Tienda</a></li>
            <li><a href="/cursos">Cursos</a></li>
          </ul>
        </section>
      </div>
    </section>

    <!-- ═══ Garaje ═══ -->
    <section id="garaje" class="clp-panel" data-panel="garaje" aria-labelledby="t-garaje">
      <h2 id="t-garaje" class="clp-h2">Garaje</h2>
      <% if (!vehicles.length) { %>
        <p class="clp-muted">Agrega tu moto: con la placa, los servicios del taller suman puntos solos y te avisamos del SOAT y la tecnomecánica.</p>
      <% } %>

      <div class="clp-bikes">
        <% vehicles.forEach(v => { %>
          <article class="clp-bike" aria-labelledby="bk-<%= v.plate %>">
            <header class="clp-bike-head">
              <span class="clp-plate" id="bk-<%= v.plate %>"><span><%= v.plate.slice(0, 3) %></span><span><%= v.plate.slice(3) %></span></span>
              <% if (v.model) { %><span class="clp-bike-model"><%= v.model %></span><% } %>
            </header>

            <dl class="clp-docs">
              <% [['SOAT', v.soat], ['Tecnomecánica', v.tecno]].forEach(([name, d]) => { %>
                <div data-state="<%= d.state %>"><dt><%= name %></dt><dd><%= d.label %></dd></div>
              <% }) %>
            </dl>

            <details class="clp-edit">
              <summary>Editar fechas</summary>
              <form method="post" action="/club/vehiculos/actualizar" class="clp-form-row">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="plate" value="<%= v.plate %>" />
                <label>Vence el SOAT<input type="date" name="soatExpires" value="<%= v.soat.date || '' %>" /></label>
                <label>Vence la tecnomecánica<input type="date" name="tecnoExpires" value="<%= v.tecno.date || '' %>" /></label>
                <button class="btn btn-sm" type="submit">Guardar fechas</button>
              </form>
            </details>

            <h3 class="clp-h3">Servicios en el taller</h3>
            <% if (!v.orders.length) { %>
              <p class="clp-muted">Aún no hay servicios registrados con esta placa.</p>
            <% } else { %>
              <ol class="clp-orders">
                <% v.orders.slice(0, 6).forEach(o => { %>
                  <li data-status="<%= o.status %>">
                    <span class="clp-order-date"><%= fechaCO(o.deliveredAt || o.createdAt, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                    <span class="clp-order-main">
                      <strong><%= (o.items || []).slice(0, 2).map(it => it.name).join(', ') || 'Servicio' %><% if ((o.items || []).length > 2) { %> y <%= o.items.length - 2 %> más<% } %></strong>
                      <span class="clp-order-status"><%= o.statusLabel %><% if (o.label) { %>, orden <%= o.label %><% } %></span>
                    </span>
                  </li>
                <% }) %>
              </ol>
            <% } %>

            <div class="clp-bike-actions">
              <button class="btn btn-sm btn-outline" type="button" data-modal-open="#qr-<%= v.plate %>">QR de la moto</button>
              <form method="post" action="/club/vehiculos/eliminar" data-confirm="¿Quitar la moto <%= v.plate %> de tu garaje?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="plate" value="<%= v.plate %>" />
                <button class="clp-link-danger" type="submit">Quitar del garaje</button>
              </form>
            </div>
          </article>

          <div class="modal" id="qr-<%= v.plate %>" aria-hidden="true">
            <div class="modal-backdrop" data-modal-close></div>
            <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="title-qr-<%= v.plate %>">
              <div class="modal-header">
                <h3 class="modal-title" id="title-qr-<%= v.plate %>">QR de la moto <%= v.plate %></h3>
                <button class="modal-close" type="button" aria-label="Cerrar" data-modal-close>✕</button>
              </div>
              <div class="modal-body clp-qr-body">
                <img src="/club/vehiculos/<%= v.plate %>/qr.png" alt="Código QR de la moto con placa <%= v.plate %>" width="240" height="240" loading="lazy" />
                <p class="clp-muted">Identifica tu moto en el taller.</p>
              </div>
              <div class="modal-actions">
                <a class="btn btn-outline" href="/club/vehiculos/<%= v.plate %>/qr.png" download="QR-<%= v.plate %>.png">Descargar</a>
                <button class="btn" type="button" data-modal-close>Cerrar</button>
              </div>
            </div>
          </div>
        <% }) %>

        <details class="clp-bike clp-bike-add"<%= vehicles.length ? '' : ' open' %>>
          <summary>Agregar moto</summary>
          <form method="post" action="/club/vehiculos" class="clp-form-row">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Placa<input name="plate" maxlength="7" placeholder="ABC12D" required autocapitalize="characters" pattern="[A-Za-z0-9]{3,7}" class="clp-plate-input" /></label>
            <label>Vence el SOAT<input type="date" name="soatExpires" /></label>
            <label>Vence la tecnomecánica<input type="date" name="tecnoExpires" /></label>
            <button class="btn btn-sm" type="submit">Agregar moto</button>
          </form>
        </details>
      </div>

      <% if (quotations && quotations.length) { %>
        <section class="clp-block" aria-labelledby="t-quotes">
          <h3 id="t-quotes" class="clp-h3">Cotizaciones</h3>
          <ul class="clp-ledger">
            <% quotations.slice(0, 8).forEach(q => { %>
              <li>
                <span class="clp-ledger-date"><%= fechaCO(q.createdAt, { day: 'numeric', month: 'short' }) %></span>
                <span><a href="/cotizacion/<%= q.id %>" target="_blank" rel="noopener">Cotización <%= q.label %></a><% if (q.motorcycle) { %>, <%= q.motorcycle %><% } %></span>
                <strong>$<%= fmt(q.total) %></strong>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>
    </section>

    <!-- ═══ Club ═══ -->
    <section id="club" class="clp-panel" data-panel="club" aria-labelledby="t-club">
      <h2 id="t-club" class="clp-h2">Tu chaleco</h2>
      <div class="clp-vest-grid">
        <figure class="clp-vest">
          <%- include('../partials/club/vest', {
            vid: 'pv', badges, levelName: lvl.name, levelColor: lvl.color || '#F25C05',
            bottomText: user.city || 'Bogotá',
          }) %>
          <figcaption class="clp-muted"><%= earnedCount %> de <%= badges.length %> insignias cosidas.</figcaption>
        </figure>
        <ul class="clp-badges">
          <% badges.forEach(b => { %>
            <li class="<%= b.earned ? 'is-earned' : '' %>">
              <svg class="clp-badge-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#pv-i-<%= b.icon %>" /></svg>
              <span class="clp-badge-text">
                <strong><%= b.name %></strong>
                <span><%= b.desc %></span>
              </span>
              <span class="clp-badge-state">
                <% if (b.earned) { %>Cosida<% } else if (b.goal > 1) { %><%= b.stat === 'daysInClub' ? `${fmt(b.value)} de ${fmt(b.goal)} días` : `${b.value} de ${b.goal}` %><% } else { %>Pendiente<% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="clp-split">
        <section class="clp-block" aria-labelledby="t-levels">
          <h3 id="t-levels" class="clp-h3">Niveles</h3>
          <ol class="clp-levels">
            <% progress.levels.forEach((l, i) => { %>
              <li class="<%= i === progress.index ? 'is-current' : (i < progress.index ? 'is-done' : '') %>" style="--lvl: <%= l.color || '#6b7280' %>">
                <span class="clp-level-dot" aria-hidden="true"></span>
                <span class="clp-level-name"><%= l.name %><% if (i === progress.index) { %> <span class="clp-chip">Tu nivel</span><% } %></span>
                <span class="clp-level-pts"><%= fmt(l.min) %> pts</span>
                <% if (l.benefits && l.benefits.length) { %>
                  <ul class="clp-level-benefits"><% l.benefits.forEach(t => { %><li><%= t %></li><% }) %></ul>
                <% } %>
              </li>
            <% }) %>
          </ol>
        </section>

        <section class="clp-block" aria-labelledby="t-rank">
          <h3 id="t-rank" class="clp-h3">Tu posición</h3>
          <% if (firstRank) { %>
            <ol class="clp-board" start="<%= firstRank %>">
              <% board.forEach((r, i) => { %>
                <li class="<%= r.me ? 'is-me' : '' %>">
                  <span class="clp-board-pos"><%= firstRank + i %></span>
                  <span class="clp-board-name"><%= r.me ? 'Tú' : (r.nickname || String(r.name || '').split(' ')[0]) %></span>
                  <span class="clp-board-pts"><%= fmt(r.score) %> pts</span>
                </li>
              <% }) %>
            </ol>
          <% } %>
          <a class="lp-link" href="/club/tabla">Ver la tabla completa</a>
        </section>
      </div>

      <section class="clp-block" aria-labelledby="t-events">
        <h3 id="t-events" class="clp-h3">Próximas salidas</h3>
        <% if (!upcomingEvents.length) { %>
          <p class="clp-muted">No hay salidas programadas por ahora.</p>
        <% } else { %>
          <ul class="clp-events">
            <% upcomingEvents.forEach(ev => { const d = dd(ev.date); const st = registrations[ev.id]; const p = pts[ev.type] || pts.evento; %>
              <li data-type="<%= ev.type %>">
                <span class="clp-ev-date" aria-hidden="true"><span><%= d.wd %></span><strong><%= d.day %></strong><span><%= d.mon %></span></span>
                <span class="clp-ev-main">
                  <span class="clp-ev-type"><%= typeName[ev.type] || 'Evento' %>, +<%= p %> pts</span>
                  <strong><%= ev.title %></strong>
                  <span class="sr-only"><%= d.wd %> <%= d.day %> de <%= d.mon %>.</span>
                  <% if (ev.location) { %><span class="clp-muted"><%= ev.location %></span><% } %>
                </span>
                <span class="clp-ev-act">
                  <% if (st === 'confirmed') { %><span class="clp-chip is-ok">Asististe</span>
                  <% } else if (st === 'pending') { %><span class="clp-chip">Inscrito</span>
                  <% } else { %>
                    <form method="post" action="/club/eventos/<%= ev.id %>/asistencia">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="back" value="panel" />
                      <button class="btn btn-sm" type="submit">Apuntarme</button>
                    </form>
                  <% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="clp-block" aria-labelledby="t-history">
        <h3 id="t-history" class="clp-h3">Historial de puntos</h3>
        <% if (!history.length) { %>
          <p class="clp-muted">Aún no hay movimientos.</p>
        <% } else { %>
          <ul class="clp-ledger">
            <% history.slice(0, 30).forEach(h => { %>
              <li><span class="clp-ledger-date"><%= shortDate(h.date) %></span><span><%= h.description || conceptName[h.concept] || 'Actividad' %></span><strong>+<%= h.points %></strong></li>
            <% }) %>
          </ul>
        <% } %>
        <p class="clp-muted clp-small">Puntos por actividad: rodada <%= pts.rodada %>, encuentro <%= pts.encuentro %>, servicio en el taller <%= pts.mantenimiento %>, visita <%= pts.visita %>. El taller los registra con tu credencial o al entregarte la moto.</p>
      </section>
    </section>

    <!-- ═══ Cuenta ═══ -->
    <section id="cuenta" class="clp-panel" data-panel="cuenta" aria-labelledby="t-cuenta">
      <h2 id="t-cuenta" class="clp-h2">Cuenta</h2>

      <div class="clp-split">
        <section class="clp-block" aria-labelledby="t-profile">
          <h3 id="t-profile" class="clp-h3">Tus datos</h3>
          <dl class="clp-facts">
            <div><dt>Nombre</dt><dd><%= user.name %></dd></div>
            <div><dt>Apodo</dt><dd><%= user.nickname || 'Sin apodo' %></dd></div>
            <div><dt>Correo</dt><dd><%= user.email %></dd></div>
            <div><dt>Teléfono</dt><dd><%= user.phone || 'Sin teléfono' %></dd></div>
            <div><dt>RH</dt><dd><%= user.bloodType || 'Sin dato' %></dd></div>
            <div><dt>Contacto de emergencia</dt><dd><%= user.emergencyName ? `${user.emergencyName}, ${user.emergencyPhone || ''}` : 'Sin dato' %></dd></div>
            <div><dt>En el club desde</dt><dd><%= user.membership && user.membership.since ? fechaCO(user.membership.since, { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></dd></div>
          </dl>
          <% if (!user.bloodType || !user.emergencyName) { %>
            <p class="clp-muted clp-small">El RH y el contacto de emergencia los usa el club si pasa algo en una rodada.</p>
          <% } %>
          <button class="btn btn-sm" type="button" data-modal-open="#editProfile">Editar datos</button>
        </section>

        <section class="clp-block" aria-labelledby="t-sec">
          <h3 id="t-sec" class="clp-h3">Acceso con huella o rostro</h3>
          <p class="clp-muted">Las llaves de acceso (passkeys) te dejan entrar con la huella, el rostro o el PIN del teléfono, sin contraseña.</p>
          <div id="passkeyMsg" class="clp-msg" role="status" hidden></div>
          <% if (passkeys && passkeys.length) { %>
            <ul class="clp-keys">
              <% passkeys.forEach(pk => { %>
                <li>
                  <span><strong><%= pk.name || 'Llave de acceso' %></strong><span class="clp-muted">Creada el <%= fechaCO(pk.createdAt, { day: 'numeric', month: 'short', year: 'numeric' }) %></span></span>
                  <form method="post" action="/club/auth/passkey/<%= pk.id %>/delete" data-confirm="¿Eliminar esta llave de acceso?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="clp-link-danger" type="submit">Eliminar</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
          <button class="btn btn-sm btn-outline" type="button" id="addPasskeyBtn">Agregar llave de acceso</button>
        </section>
      </div>

      <section class="clp-block clp-danger" aria-labelledby="t-danger">
        <h3 id="t-danger" class="clp-h3">Salir o eliminar la cuenta</h3>
        <div class="clp-danger-row">
          <form method="post" action="/club/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn btn-sm btn-outline" type="submit">Cerrar sesión</button>
          </form>
          <button class="clp-link-danger" type="button" data-modal-open="#deleteAccount">Eliminar mi cuenta</button>
        </div>
      </section>
    </section>

  </div>

  <!-- ── Editar perfil ── -->
  <div class="modal" id="editProfile" aria-hidden="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="title-editProfile">
      <div class="modal-header">
        <h3 class="modal-title" id="title-editProfile">Editar mis datos</h3>
        <button class="modal-close" type="button" aria-label="Cerrar" data-modal-close>✕</button>
      </div>
      <form method="post" action="/club/perfil">
        <div class="modal-body">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <%- include('../partials/profile-fields', { u: user, admin: false }) %>
        </div>
        <div class="modal-actions">
          <button class="btn btn-outline" type="button" data-modal-close>Cancelar</button>
          <button class="btn" type="submit">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ── Eliminar cuenta ── -->
  <div class="modal" id="deleteAccount" aria-hidden="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="title-deleteAccount">
      <div class="modal-header">
        <h3 class="modal-title clp-danger-title" id="title-deleteAccount">Eliminar mi cuenta</h3>
        <button class="modal-close" type="button" aria-label="Cerrar" data-modal-close>✕</button>
      </div>
      <form method="post" action="/club/eliminar-cuenta" id="deleteAccountForm">
        <div class="modal-body clp-form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <p>Esta acción <strong>no se puede deshacer</strong>. Se borran tus datos personales, tus puntos y tus insignias.</p>
          <% if (hasPassword) { %>
            <label>Confirma tu contraseña<input type="password" name="password" autocomplete="current-password" required /></label>
          <% } %>
          <label>Escribe <strong>ELIMINAR</strong> para confirmar<input type="text" name="confirm" id="deleteConfirmInput" autocomplete="off" autocapitalize="characters" required /></label>
        </div>
        <div class="modal-actions">
          <button class="btn btn-outline" type="button" data-modal-close>Cancelar</button>
          <button class="btn clp-btn-danger" id="deleteAccountBtn" type="submit" disabled>Eliminar definitivamente</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Llaves de acceso (passkeys): registro con WebAuthn.
(function () {
  const btn = document.getElementById('addPasskeyBtn');
  const msg = document.getElementById('passkeyMsg');
  if (!btn) return;
  const label = btn.textContent;
  function b64uToBuffer(b) {
    const s = atob(b.replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(s, c => c.charCodeAt(0)).buffer;
  }
  function bufToB64u(buf) {
    const b = new Uint8Array(buf);
    let s = ''; for (const x of b) s += String.fromCharCode(x);
    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
  }
  function showMsg(text, ok) {
    msg.textContent = text;
    msg.dataset.tone = ok ? 'ok' : 'error';
    msg.hidden = false;
  }
  if (!window.PublicKeyCredential) {
    btn.disabled = true;
    btn.title = 'Este navegador no admite llaves de acceso';
    return;
  }
  btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'Preparando…';
    try {
      const optsRes = await fetch('/club/auth/passkey/register-options');
      if (!optsRes.ok) throw new Error('No se pudieron obtener las opciones.');
      const opts = await optsRes.json();
      opts.challenge = b64uToBuffer(opts.challenge);
      opts.user.id = b64uToBuffer(opts.user.id);
      if (opts.excludeCredentials) opts.excludeCredentials = opts.excludeCredentials.map(c => ({ ...c, id: b64uToBuffer(c.id) }));
      const cred = await navigator.credentials.create({ publicKey: opts });
      const body = {
        id: cred.id,
        rawId: bufToB64u(cred.rawId),
        type: cred.type,
        response: {
          attestationObject: bufToB64u(cred.response.attestationObject),
          clientDataJSON: bufToB64u(cred.response.clientDataJSON),
          transports: cred.response.getTransports?.() || [],
        },
        clientExtensionResults: cred.getClientExtensionResults(),
      };
      const csrf = document.querySelector('input[name="_csrf"]')?.value || '';
      const res = await fetch('/club/auth/passkey/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'No se pudo registrar la llave.');
      showMsg('Llave de acceso agregada. Recargando…', true);
      setTimeout(() => location.reload(), 1200);
    } catch (e) {
      showMsg(e.name === 'NotAllowedError' ? 'Operación cancelada.' : (e.message || 'Error inesperado.'), false);
      btn.disabled = false;
      btn.textContent = label;
    }
  });
})();

// El botón de baja solo se habilita al escribir exactamente "ELIMINAR".
(function () {
  const input = document.getElementById('deleteConfirmInput');
  const delBtn = document.getElementById('deleteAccountBtn');
  if (!input || !delBtn) return;
  input.addEventListener('input', () => { delBtn.disabled = input.value.trim().toUpperCase() !== 'ELIMINAR'; });
})();
</script>
<script defer src="/static/vendor/gsap-3.15.0/gsap.min.js"></script>
<script type="module" src="/static/js/club/panel.mjs?v=<%= assetV('js/club/panel.mjs') %>"></script>

<%- include('../partials/footer') %>
