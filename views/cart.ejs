<%- include('partials/head', { extraCss: ['/static/css/tienda.css?v=' + assetV('css/tienda.css')] }) %>
<div class="tn-page tn-page--narrow">
  <% if (!priced.lines.length) { %>
    <div class="tn-empty tn-empty--page">
      <svg class="ni" aria-hidden="true"><use href="#ni-cart"/></svg>
      <h1 class="tn-h1">Tu carrito está vacío</h1>
      <p>Mira la tienda o, si buscas algo puntual, pregúntanos por WhatsApp.</p>
      <div class="tn-empty-actions">
        <a class="tn-btn tn-btn--primary" href="/tienda">Ir a la tienda</a>
        <a class="tn-btn tn-btn--ghost" href="<%= waLink(waMsg.shop()) %>" target="_blank" rel="noopener">Preguntar por WhatsApp</a>
      </div>
    </div>
  <% } else { %>
    <header class="tn-head tn-head--row">
      <h1 class="tn-h1">Tu carrito</h1>
      <a class="tn-link" href="/tienda">Seguir comprando</a>
    </header>

    <div class="tn-cart">
      <ul class="tn-lines" role="list">
        <% priced.lines.forEach(function (l) { %>
        <li class="tn-line">
          <a class="tn-line-img" href="/tienda/<%= l.slug %>" tabindex="-1" aria-hidden="true">
            <% if (l.image) { %><img src="<%= l.image %>" alt="" width="88" height="88" loading="lazy" /><% } else { %><span class="tn-nophoto"><svg class="ni" aria-hidden="true"><use href="#ni-bike"/></svg></span><% } %>
          </a>
          <div class="tn-line-body">
            <a class="tn-line-name" href="/tienda/<%= l.slug %>"><%= l.name %></a>
            <% if (l.variantLabel) { %><span class="tn-muted"><%= l.variantLabel %></span><% } %>
            <span class="tn-line-unit"><%= fmtCOP(l.unitPrice) %> c/u<% if (l.unitPrice < l.unitBase) { %> <s><%= fmtCOP(l.unitBase) %></s><% } %><% if (l.isClubApplied) { %> · precio club<% } %></span>
            <form class="tn-line-qty" method="post" action="/cart/update">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="key" value="<%= l.key %>" />
              <div class="tn-qty-ctrl">
                <button type="submit" name="qty" value="<%= l.qty - 1 %>" aria-label="Quitar una unidad">-</button>
                <output aria-live="polite"><%= l.qty %></output>
                <button type="submit" name="qty" value="<%= l.qty + 1 %>" aria-label="Agregar una unidad">+</button>
              </div>
              <button class="tn-link tn-link--danger" type="submit" name="qty" value="0">Quitar</button>
            </form>
            <form class="tn-line-install" method="post" action="/cart/install" data-autosubmit-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="key" value="<%= l.key %>" />
              <input type="hidden" name="on" value="<%= l.install ? '0' : '1' %>" />
              <% if (l.install) { %>
                <p class="tn-chip-ok"><svg class="ni" aria-hidden="true"><use href="#ni-wrench"/></svg>Con instalación en el taller<%= l.installPrice !== null ? ': ' + fmtCOP(l.installTotal) : ' (valor a confirmar)' %> <button class="tn-link" type="submit">Quitar instalación</button></p>
              <% } else if (installableKeys.indexOf(l.key) >= 0) { %>
                <button class="tn-link" type="submit"><svg class="ni" aria-hidden="true"><use href="#ni-wrench"/></svg>Agregar instalación en el taller</button>
              <% } %>
            </form>
          </div>
          <strong class="tn-line-total"><%= fmtCOP(l.lineTotal) %></strong>
        </li>
        <% }) %>
      </ul>

      <aside class="tn-summary" aria-label="Resumen del pedido">
        <h2 class="tn-h2">Resumen</h2>
        <dl class="tn-totals">
          <div><dt>Productos (<%= priced.count %>)</dt><dd><%= fmtCOP(priced.itemsSubtotal) %></dd></div>
          <% priced.discounts.forEach(function (d) { %><div class="is-discount"><dt><%= d.label %></dt><dd>- <%= fmtCOP(d.amount) %></dd></div><% }) %>
          <% if (priced.hasInstallation) { %><div><dt>Instalación</dt><dd><%= priced.installationTotal ? fmtCOP(priced.installationTotal) : '' %><%= priced.installationPending ? (priced.installationTotal ? ' + ' : '') + 'a confirmar' : '' %></dd></div><% } %>
          <div><dt>Entrega</dt><dd><%= deliveryMethods.length ? 'Se calcula al pagar' : '' %></dd></div>
          <div class="is-total"><dt>Total</dt><dd><%= fmtCOP(priced.merchandise + priced.installationTotal) %></dd></div>
        </dl>
        <% if (priced.savings > 0) { %><p class="tn-savings">Estás ahorrando <%= fmtCOP(priced.savings) %></p><% } %>
        <% if (deliveryMethods.length) { %>
          <p class="tn-muted">Entrega disponible: <%= deliveryMethods.map(function (m) { return METHOD_LABELS[m].toLowerCase(); }).join(', ') %>.</p>
        <% } %>
        <a class="tn-btn tn-btn--primary tn-btn--lg tn-btn--block" href="/checkout">Continuar al pago</a>
        <p class="tn-muted tn-center">Compra sin crear cuenta. <% if (!user) { %><a href="/club/login?return=/checkout">¿Eres del club? Inicia sesión</a><% } %></p>
        <form method="post" action="/cart/clear" class="tn-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="tn-link tn-link--danger">Vaciar carrito</button>
        </form>
      </aside>
    </div>

    <% if (suggestions.length) { %>
    <section class="tn-section">
      <h2 class="tn-h2">Va bien con lo que llevas</h2>
      <div class="tn-grid tn-grid--row">
        <% suggestions.forEach(function (p) { %><%- include('partials/tienda/card', { p: p, price: priceOf(p) }) %><% }) %>
      </div>
    </section>
    <% } %>
  <% } %>
</div>
<script defer src="/static/js/tienda.js?v=<%= assetV('js/tienda.js') %>"></script>
<%- include('partials/footer') %>
