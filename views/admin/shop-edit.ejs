<%- include('../partials/admin-head', { title: title }) %>
<%- include('../partials/admin-shop-nav', { current: 'productos' }) %>
<%
  var p = product;
  var stockVal = p.ownStock === null || p.ownStock === undefined ? '' : p.ownStock;
  var specsText = (p.specs || []).map(function (s) { return s.value ? s.label + ': ' + s.value : s.label; }).join('\n');
%>
<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
  <div class="ash-err"><strong>Revisa:</strong><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="/admin/tienda/guardar" id="productForm" data-admin-product>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <% if (p.id) { %><input type="hidden" name="id" value="<%= p.id %>" /><% } %>

  <div class="crm-page-header">
    <h1 class="crm-page-title"><%= p.id ? p.name : 'Nuevo producto' %></h1>
    <div class="ash-row">
      <% if (p.id) { %><a class="btn btn-ghost btn-sm" href="/tienda/<%= p.slug %>" target="_blank" rel="noopener">Ver en la tienda</a><% } %>
      <button class="btn btn-primary btn-sm" type="submit">Guardar</button>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Datos básicos</div>
    <div class="crm-form-grid">
      <div class="crm-form-group crm-form-full"><label>Nombre <span class="required">*</span></label><input name="name" required value="<%= p.name %>" placeholder="Incluye el modelo si es específico: Defensa para Yamaha MT-03" /></div>
      <div class="crm-form-group"><label>URL (slug)</label><input name="slug" value="<%= p.slug %>" placeholder="se genera del nombre" /><p class="ash-help">Si la cambias, la URL anterior redirige sola (301).</p></div>
      <div class="crm-form-group"><label>Estado</label>
        <select name="status">
          <option value="draft" <%= p.status === 'draft' ? 'selected' : '' %>>Borrador (no se ve)</option>
          <option value="active" <%= p.status === 'active' ? 'selected' : '' %>>Publicado</option>
          <option value="archived" <%= p.status === 'archived' ? 'selected' : '' %>>Archivado</option>
        </select>
        <% if (p.isDemo) { %><label class="ash-check"><input type="checkbox" name="keepDemo" value="1" checked /> Mantener como demo (no se publica en producción)</label><% } %>
      </div>
      <div class="crm-form-group"><label>Categoría <span class="required">*</span></label>
        <select name="category" required><option value="">Elige</option><% categories.forEach(function (c) { %><option value="<%= c.slug %>" <%= p.category === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
      </div>
      <div class="crm-form-group"><label>Marca del fabricante</label><input name="brand" value="<%= p.brand || '' %>" placeholder="La marca real del producto" /></div>
      <div class="crm-form-group"><label>SKU / referencia</label><input name="sku" value="<%= p.sku || '' %>" /></div>
      <div class="crm-form-group crm-form-full"><label class="ash-check"><input type="checkbox" name="featured" value="1" <%= p.featured ? 'checked' : '' %> /> Destacado (sale primero y en el home)</label></div>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Precio y stock</div>
    <div class="crm-form-grid">
      <div class="crm-form-group"><label>Precio (COP) <span class="required">*</span></label><input name="price" inputmode="numeric" required value="<%= p.price || '' %>" data-price /></div>
      <div class="crm-form-group"><label>Descuento (%)</label><input name="discount" type="number" min="0" max="100" value="<%= p.discount || 0 %>" data-discount /></div>
      <div class="crm-form-group"><label>Descuento club (%)</label><input name="clubDiscount" type="number" min="0" max="100" value="<%= p.clubDiscount || 0 %>" data-club /><p class="ash-help">Para miembros con sesión. Aplica el mayor entre este y el descuento normal.</p></div>
      <div class="crm-form-group"><label>Stock</label><input name="stock" type="number" min="0" value="<%= stockVal %>" placeholder="vacío = no controlar" /><p class="ash-help">Si el producto tiene variantes, el stock se lleva por variante.</p></div>
      <div class="crm-form-group crm-form-full"><p class="ash-preview" data-price-preview></p></div>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Variantes (color / talla)</div>
    <p class="ash-help">Deja el precio vacío para usar el del producto. Stock vacío = no controlar.</p>
    <table class="crm-table ash-table" data-variants>
      <thead><tr><th>Color</th><th>Talla</th><th>SKU</th><th>Precio</th><th>Stock</th><th></th></tr></thead>
      <tbody>
        <% (p.variants || []).forEach(function (v, i) { %>
        <tr>
          <td><input type="hidden" name="variants[<%= i %>][id]" value="<%= v.id || '' %>" /><input name="variants[<%= i %>][color]" value="<%= v.color %>" /></td>
          <td><input name="variants[<%= i %>][size]" value="<%= v.size %>" /></td>
          <td><input name="variants[<%= i %>][sku]" value="<%= v.sku %>" /></td>
          <td><input name="variants[<%= i %>][price]" inputmode="numeric" value="<%= v.price === null ? '' : v.price %>" /></td>
          <td><input name="variants[<%= i %>][stock]" type="number" min="0" value="<%= v.stock === null ? '' : v.stock %>" /></td>
          <td><button type="button" class="btn btn-ghost btn-xs" data-remove-row>Quitar</button></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <button type="button" class="btn btn-ghost btn-sm" data-add-variant style="margin-top:8px">+ Agregar variante</button>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Fotos</div>
    <p class="ash-help">Solo fotos propias del producto. La primera es la principal. Se reducen a WebP antes de subirlas. Escribe un texto alternativo que describa la foto.</p>
    <div class="ash-imgs" data-images>
      <% (p.images || []).forEach(function (img, i) { %>
      <div class="ash-img">
        <img src="<%= img.url %>" alt="" />
        <input type="hidden" name="images[<%= i %>][url]" value="<%= img.url %>" />
        <input name="images[<%= i %>][alt]" value="<%= img.alt %>" placeholder="Texto alternativo" />
        <div class="ash-img-actions"><button type="button" data-img-left title="Mover antes">&lt;</button><button type="button" data-img-right title="Mover después">&gt;</button><button type="button" data-remove-img title="Quitar">x</button></div>
      </div>
      <% }) %>
    </div>
    <label class="btn btn-ghost btn-sm" style="margin-top:10px;cursor:pointer">Subir fotos<input type="file" accept="image/jpeg,image/png,image/webp" multiple hidden data-upload /></label>
    <span class="ash-help" data-upload-status></span>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Compatibilidad</div>
    <p class="ash-help">Modelos en los que sirve. Años vacíos = todos los del modelo. ¿Falta un modelo? <a href="/admin/tienda/motos">Créalo aquí</a>.</p>
    <table class="crm-table ash-table" data-compat>
      <thead><tr><th>Modelo</th><th>Desde (año)</th><th>Hasta (año)</th><th></th></tr></thead>
      <tbody>
        <% (p.compat || []).forEach(function (c, i) { %>
        <tr>
          <td><select name="compat[<%= i %>][model]"><% bikeModels.forEach(function (m) { %><option value="<%= m.id %>" <%= c.bikeModelId === m.id ? 'selected' : '' %>><%= m.brand %> <%= m.model %><%= m.cc ? ' ' + m.cc + ' cc' : '' %></option><% }) %></select></td>
          <td><input name="compat[<%= i %>][from]" type="number" value="<%= c.yearFrom || '' %>" /></td>
          <td><input name="compat[<%= i %>][to]" type="number" value="<%= c.yearTo || '' %>" /></td>
          <td><button type="button" class="btn btn-ghost btn-xs" data-remove-row>Quitar</button></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (bikeModels.length) { %><button type="button" class="btn btn-ghost btn-sm" data-add-compat style="margin-top:8px">+ Agregar modelo</button><% } %>
    <template data-compat-options><% bikeModels.forEach(function (m) { %><option value="<%= m.id %>"><%= m.brand %> <%= m.model %><%= m.cc ? ' ' + m.cc + ' cc' : '' %></option><% }) %></template>
    <div class="crm-form-group" style="margin-top:14px"><label>Tipos de moto</label>
      <div class="ash-checks"><% bikeTypes.forEach(function (t) { %><label class="ash-check"><input type="checkbox" name="bikeTypes" value="<%= t.slug %>" <%= (p.bikeTypes || []).indexOf(t.slug) >= 0 ? 'checked' : '' %> /> <%= t.name %></label><% }) %></div>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Contenido de la ficha</div>
    <div class="crm-form-grid">
      <div class="crm-form-group crm-form-full"><label>Descripción</label><textarea name="description" rows="6" placeholder="Texto propio. Separa párrafos con una línea en blanco."><%= p.description || '' %></textarea></div>
      <div class="crm-form-group"><label>Especificaciones</label><textarea name="specs" rows="6" placeholder="Material: Aluminio&#10;Peso: 1,2 kg"><%= specsText %></textarea><p class="ash-help">Una por línea, con el formato Etiqueta: valor.</p></div>
      <div class="crm-form-group"><label>Qué incluye</label><textarea name="includes" rows="6" placeholder="Un elemento por línea"><%= p.includes || '' %></textarea></div>
      <div class="crm-form-group"><label>Garantía</label><input name="warranty" value="<%= p.warranty || '' %>" placeholder="Ej: 6 meses por defectos de fabricación" /></div>
      <div class="crm-form-group"><label>Tiempo de entrega</label><input name="deliveryTime" value="<%= p.deliveryTime || '' %>" placeholder="Ej: disponible para recoger hoy" /></div>
      <div class="crm-form-group crm-form-full"><label>Etiquetas (separadas por coma)</label><input name="tags" value="<%= (p.tags || []).join(', ') %>" /></div>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">Instalación y servicios</div>
    <div class="crm-form-grid">
      <div class="crm-form-group crm-form-full"><label class="ash-check"><input type="checkbox" name="installable" value="1" <%= p.installable ? 'checked' : '' %> /> Se puede instalar en el taller (aparece el add-on en ficha y carrito)</label></div>
      <div class="crm-form-group"><label>Precio de instalación por unidad (COP)</label><input name="installPrice" inputmode="numeric" value="<%= typeof p.installPrice === 'number' ? p.installPrice : '' %>" placeholder="vacío = se confirma en el taller" /></div>
      <div class="crm-form-group"><label>Duración estimada (minutos)</label><input name="installMinutes" type="number" min="0" value="<%= p.installMinutes || '' %>" /></div>
      <div class="crm-form-group crm-form-full"><label>Servicios relacionados (venta cruzada)</label>
        <div class="ash-checks"><% services.forEach(function (s) { %><label class="ash-check"><input type="checkbox" name="relatedServices" value="<%= s.slug %>" <%= (p.relatedServices || []).indexOf(s.slug) >= 0 ? 'checked' : '' %> /> <%= s.name %></label><% }) %></div>
      </div>
    </div>
  </div>

  <div class="crm-card">
    <div class="crm-card-title">SEO (opcional)</div>
    <p class="ash-help">Si los dejas vacíos se generan: "{Producto} para {moto} | Gorillaz Motorbikes" y una descripción con precio.</p>
    <div class="crm-form-grid">
      <div class="crm-form-group"><label>Título</label><input name="seoTitle" maxlength="70" value="<%= p.seoTitle || '' %>" /></div>
      <div class="crm-form-group"><label>Descripción</label><input name="seoDescription" maxlength="170" value="<%= p.seoDescription || '' %>" /></div>
    </div>
  </div>

  <div class="crm-form-actions"><button class="btn btn-primary" type="submit">Guardar producto</button></div>
</form>
<script src="/static/js/admin-tienda.js?v=<%= assetV('js/admin-tienda.js') %>" defer></script>
<%- include('../partials/admin-foot') %>
