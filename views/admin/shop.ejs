<%- include('../partials/admin-head', { title: 'Tienda' }) %>
<%- include('../partials/admin-shop-nav', { current: 'productos' }) %>

<div class="crm-page-header">
  <div class="ash-row">
    <a class="btn btn-primary btn-sm" href="/admin/tienda/nuevo">+ Nuevo producto</a>
    <a class="btn btn-ghost btn-sm" href="/admin/tienda/exportar.csv">Exportar CSV</a>
  </div>
  <form class="ash-row" method="get" action="/admin/tienda">
    <input class="crm-search-input" name="q" value="<%= q %>" placeholder="Buscar nombre, SKU o marca" />
    <select class="crm-select" name="cat"><option value="">Todas las categorías</option><% categories.forEach(function (c) { %><option value="<%= c.slug %>" <%= cat === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
    <select class="crm-select" name="estado">
      <option value="">Todos</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Publicados (<%= counts.active %>)</option>
      <option value="draft" <%= status === 'draft' ? 'selected' : '' %>>Borradores (<%= counts.draft %>)</option>
      <option value="archived" <%= status === 'archived' ? 'selected' : '' %>>Archivados</option>
      <option value="demo" <%= status === 'demo' ? 'selected' : '' %>>Demo (<%= counts.demo %>)</option>
    </select>
    <button class="btn btn-ghost btn-sm" type="submit">Filtrar</button>
  </form>
</div>

<% if (counts.demo) { %>
<p class="ash-preview">Hay <%= counts.demo %> productos de demostración. Solo se ven en desarrollo, nunca en producción. Cuando cargues el catálogo real, archívalos.</p>
<% } %>

<div class="crm-table-wrap">
  <table class="crm-table">
    <thead><tr><th></th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!products.length) { %><tr><td colspan="7" class="muted">No hay productos con ese filtro.</td></tr><% } %>
      <% products.forEach(function (p) { var cat = categories.find(function (c) { return c.slug === p.category; }); %>
      <tr>
        <td><% if (p.image) { %><img class="crm-table-thumb" src="<%= p.image %>" alt="" width="40" height="40" /><% } %></td>
        <td>
          <a href="/admin/tienda/<%= p.id %>/editar"><strong><%= p.name %></strong></a><br>
          <span class="muted ash-mono"><%= p.sku || 'sin SKU' %> · /tienda/<%= p.slug %></span>
          <% if (p.featured) { %> <span class="ash-pill">Destacado</span><% } %>
          <% if (p.variants && p.variants.length) { %> <span class="ash-pill"><%= p.variants.length %> variantes</span><% } %>
        </td>
        <td><%= cat ? cat.name : 'Sin categoría' %></td>
        <td><%= fmtCOP(p.price) %><% if (p.discount) { %><br><span class="muted">-<%= p.discount %>%</span><% } %></td>
        <td><%= p.stock === null ? 'Sin control' : p.stock %></td>
        <td>
          <% if (p.isDemo) { %><span class="ash-pill demo">Demo</span>
          <% } else if (p.status === 'active') { %><span class="ash-pill ok">Publicado</span>
          <% } else if (p.status === 'draft') { %><span class="ash-pill warn">Borrador</span>
          <% } else { %><span class="ash-pill">Archivado</span><% } %>
        </td>
        <td class="crm-table-actions">
          <a class="btn btn-ghost btn-xs" href="/admin/tienda/<%= p.id %>/editar">Editar</a>
          <a class="btn btn-ghost btn-xs" href="/tienda/<%= p.slug %>" target="_blank" rel="noopener">Ver</a>
          <form method="post" action="/admin/tienda/<%= p.id %>/estado" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="status" value="<%= p.status === 'archived' ? 'draft' : 'archived' %>" />
            <button class="btn btn-ghost btn-xs" type="submit"><%= p.status === 'archived' ? 'Restaurar' : 'Archivar' %></button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/admin-foot') %>
