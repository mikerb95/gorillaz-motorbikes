<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%#
    SEO: título con la marca siempre al final, descripción por página y URL
    canónica propia (middleware/locals.js la calcula con req.path).
  %>
  <%
    var SITE = 'https://gorillazmotorbikes.com';
    var DEFAULT_TITLE = 'Gorillaz Motorbikes | Taller de motos en Bogotá';
    var DEFAULT_DESC = 'Taller de motos en Bogotá: mecánica, electricidad, escaneo, pintura, alistamiento para la tecnomecánica y tienda de accesorios. Agenda en línea.';
    var pageTitle = (typeof title !== 'undefined' && title) ? String(title).trim() : DEFAULT_TITLE;
    if (!/gorillaz/i.test(pageTitle)) pageTitle += ' | Gorillaz Motorbikes';
    var pageDesc = (typeof description !== 'undefined' && description) ? String(description).trim() : DEFAULT_DESC;
    var pagePath = (typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : '/';
    var pageUrl = SITE + pagePath;
    var pageImage = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : SITE + '/images/og-default.jpg';
    if (pageImage.charAt(0) === '/') pageImage = SITE + pageImage;
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>" />
  <link rel="canonical" href="<%= pageUrl %>" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="Gorillaz Motorbikes" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:image" content="<%= pageImage %>" />
  <% if (pageImage === SITE + '/images/og-default.jpg') { %><meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <% } %><meta property="og:url" content="<%= pageUrl %>" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= pageDesc %>" />
  <meta name="twitter:image" content="<%= pageImage %>" />
  <!-- Autor del proyecto: mikerb95 (Gorillaz Motorbikes) -->
  <link rel="icon" href="/favicons/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
  <link rel="manifest" href="/favicons/site.webmanifest" />
  <!-- PWA/Browser UI color -->
  <meta name="theme-color" content="#F25C05" />
  <meta name="msapplication-TileColor" content="#F25C05" />
  <!-- Google Fonts: Montserrat (preconnects for performance, works on Vercel) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800;900&display=swap" rel="stylesheet">
  <%# /static/* va con caché immutable: la versión cambia con el archivo (helpers/assets.js). %>
  <% var assetVer = typeof assetV === 'function' ? assetV : function () { return 'dev'; }; %>
  <link rel="stylesheet" href="/static/css/styles.css?v=<%= assetVer('css/styles.css') %>" />
  <meta name="view-transition" content="same-origin" />
  <%# Transiciones de vista entre páginas: no pintar hasta que exista el elemento que las recibe. %>
  <% if (typeof vtExpect !== 'undefined' && vtExpect) { %><link rel="expect" href="#<%= vtExpect %>" blocking="render" /><% } %>
  <%# Hojas propias de la página: en el head bloquean el primer pintado (un @view-transition en el body llega tarde). %>
  <% if (typeof extraCss !== 'undefined') { extraCss.forEach(function (href) { %><link rel="stylesheet" href="<%= href %>" />
  <% }) } %>
  <% if (typeof noIndex !== 'undefined' && noIndex) { %><meta name="robots" content="noindex, nofollow" /><% } %>

  <% if (typeof csrfToken !=='undefined' && csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
      <script defer src="/static/js/main.js?v=<%= assetVer('js/main.js') %>"></script>
      <script defer src="/static/js/colombia-cities.js"></script>
      <script defer src="/static/js/motorcycle-brands.js"></script>
  <% var asesorV = assetVer; %>
  <link rel="stylesheet" href="/static/css/asesor.css?v=<%= asesorV('css/asesor.css') %>" />
  <script defer src="/static/js/asesor.js?v=<%= asesorV('js/asesor.js') %>"></script>
</head>

<body<% if (typeof bodyClass !== 'undefined' && bodyClass) { %> class="<%= bodyClass %>"<% } %>>
  <%# Íconos de la navbar: <svg class="ni"><use href="#ni-NOMBRE"/></svg>. Trazo de 2px como el resto del header. %>
  <svg class="ni-sprite" aria-hidden="true" focusable="false">
    <symbol id="ni-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
    <symbol id="ni-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="ni-wrench" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.3 5.3L3.5 17.5a1.4 1.4 0 0 0 0 2l1 1a1.4 1.4 0 0 0 2 0l5.9-5.9a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.3-.5-.5-2.3z"/></symbol>
    <symbol id="ni-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="ni-bolt" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></symbol>
    <symbol id="ni-scan" viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M7 12h10"/></symbol>
    <symbol id="ni-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="7"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></symbol>
    <symbol id="ni-press" viewBox="0 0 24 24"><path d="M5 3h14M12 3v7M8 10h8v3H8zM4 21h16M7 21v-4h10v4"/></symbol>
    <symbol id="ni-brush" viewBox="0 0 24 24"><path d="M18 3l3 3-9 9-3-3zM9 12c-3 0-5 2-5 5 0 1.5-1 2.5-2 3 3 1 7 0 8.5-2.5.7-1.3.5-2.5-.5-3.5"/></symbol>
    <symbol id="ni-drop" viewBox="0 0 24 24"><path d="M12 3s-6 6.5-6 11a6 6 0 0 0 12 0c0-4.5-6-11-6-11z"/></symbol>
    <symbol id="ni-sparkle" viewBox="0 0 24 24"><path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></symbol>
    <symbol id="ni-helmet" viewBox="0 0 24 24"><path d="M3 16a9 9 0 0 1 18 0v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM12 12h8.6"/></symbol>
    <symbol id="ni-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5 4.5-5"/></symbol>
    <symbol id="ni-doc" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 12h10"/></symbol>
    <symbol id="ni-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .6 3 2.5 3 6"/></symbol>
    <symbol id="ni-tag" viewBox="0 0 24 24"><path d="M3 12V4h8l9 9-8 8z"/><circle cx="7.5" cy="7.5" r="1.3"/></symbol>
    <symbol id="ni-login" viewBox="0 0 24 24"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4M3 12h11M10 8l4 4-4 4"/></symbol>
    <symbol id="ni-logout" viewBox="0 0 24 24"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M21 12H10M17 8l4 4-4 4"/></symbol>
    <symbol id="ni-userplus" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 20c0-3.9 3.1-7 7-7s7 3.1 7 7M19 8v6M16 11h6"/></symbol>
    <symbol id="ni-gauge" viewBox="0 0 24 24"><path d="M4 18a8 8 0 1 1 16 0M12 18l4-6"/></symbol>
    <symbol id="ni-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/></symbol>
    <symbol id="ni-bike" viewBox="0 0 24 24"><circle cx="5.5" cy="16" r="3"/><circle cx="18.5" cy="16" r="3"/><path d="M5.5 16l4-7h5l4 7M7 9h3M14.5 9l1.5-3h2"/></symbol>
    <symbol id="ni-book" viewBox="0 0 24 24"><path d="M5 18V6a2 2 0 0 1 2-2h12v14H7a2 2 0 0 0-2 2 2 2 0 0 0 2 2h12"/></symbol>
    <symbol id="ni-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.5 12h9l2-8H7.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></symbol>
    <symbol id="ni-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></symbol>
  </svg>
  <%
    var nav = (typeof navMenu !== 'undefined' && navMenu) ? navMenu : { serviceGroups: [], shop: { categories: [], quick: [] } };
    var navCartRows = (typeof cartItems !== 'undefined' && cartItems) ? cartItems : [];
    var navCartCount = (typeof cart !== 'undefined' && cart && cart.count) || 0;
    var navCartTotal = (typeof cart !== 'undefined' && cart && cart.subtotal) || 0;
    var navEvents = (typeof eventsUpcoming !== 'undefined' && eventsUpcoming) ? eventsUpcoming : 0;
    var navEventsHref = '/eventos' + ((typeof eventsFirstAnchor !== 'undefined' && eventsFirstAnchor) ? eventsFirstAnchor : '');
  %>
  <header class="site-header">
    <div class="mnav-backdrop" aria-hidden="true"></div>
    <div class="nav-bar">
      <div class="header-inner">
        <div class="nav-left">
          <nav class="nav" data-nav>
            <div class="nav-links">
              <div class="nav-item has-submenu" data-panel="wide">
                <a class="nav-link" href="/servicios" aria-haspopup="true" aria-expanded="false">Servicios<svg class="ni nav-chev" aria-hidden="true"><use href="#ni-chev"/></svg></a>
                <div class="nav-submenu nav-panel nav-panel--services" aria-label="Submenú Servicios">
                  <div class="nav-panel-cols">
                    <% nav.serviceGroups.forEach(function (group) { %>
                    <div class="nav-panel-col">
                      <strong class="nav-panel-heading"><%= group.title %></strong>
                      <% group.items.forEach(function (it) { %>
                      <a class="nav-sub" href="<%= it.href %>">
                        <svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-<%= it.icon %>"/></svg>
                        <span class="nav-sub-text"><span class="nav-sub-title"><%= it.label %></span><span class="nav-sub-desc"><%= it.desc %></span></span>
                      </a>
                      <% }) %>
                    </div>
                    <% }) %>
                  </div>
                  <a class="nav-feature" href="/servicios/agendar?servicio=Escaneo%20de%20motos">
                    <span class="nav-feature-kicker">¿No sabes qué tiene tu moto?</span>
                    <span class="nav-feature-title">Agenda un diagnóstico</span>
                    <span class="nav-feature-go">Agendar<svg class="ni" aria-hidden="true"><use href="#ni-arrow"/></svg></span>
                  </a>
                </div>
              </div>
              <a class="nav-link" href="/cursos">Cursos</a>
              <div class="nav-item has-submenu" data-panel="item-left">
                <a class="nav-link" href="/club" aria-haspopup="true" aria-expanded="false">Club<svg class="ni nav-chev" aria-hidden="true"><use href="#ni-chev"/></svg></a>
                <div class="nav-submenu nav-panel nav-panel--compact" aria-label="Submenú Club">
                  <a class="nav-sub" href="/club"><svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-users"/></svg><span class="nav-sub-text"><span class="nav-sub-title">Sobre el Club</span></span></a>
                  <a class="nav-sub" href="/clasificados"><svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-tag"/></svg><span class="nav-sub-text"><span class="nav-sub-title">Clasificados</span></span></a>
                  <% if (!user) { %>
                  <a class="nav-sub" href="/club/login"><svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-login"/></svg><span class="nav-sub-text"><span class="nav-sub-title">Iniciar sesión</span></span></a>
                  <a class="nav-sub" href="/club/registro"><svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-userplus"/></svg><span class="nav-sub-text"><span class="nav-sub-title">Registro</span></span></a>
                  <% } else { %>
                  <a class="nav-sub" href="/club/panel"><svg class="ni nav-sub-icon" aria-hidden="true"><use href="#ni-gauge"/></svg><span class="nav-sub-text"><span class="nav-sub-title">Mi panel</span></span></a>
                  <% } %>
                </div>
              </div>
            </div>
          </nav>
        </div>
        <div class="nav-center">
          <a href="/" class="logo" aria-label="Gorillaz Motorbikes">
            <img class="logo-base" src="/images/nobg_logo/logo_transp.png" alt="Gorillaz Motorbikes" />
            <img class="logo-name" src="/images/nobg_logo/logo-name.png" alt="" aria-hidden="true" />
          </a>
        </div>
        <div class="header-right">
          <div class="nav-item has-submenu" data-panel="wide-right">
            <a class="nav-link" href="/tienda" aria-haspopup="true" aria-expanded="false">Tienda<svg class="ni nav-chev" aria-hidden="true"><use href="#ni-chev"/></svg></a>
            <div class="nav-submenu nav-panel nav-panel--shop" aria-label="Categorías de tienda">
              <div class="nav-panel-cols">
                <div class="nav-panel-col">
                  <strong class="nav-panel-heading">Categorías</strong>
                  <% nav.shop.categories.forEach(function (l) { %><a class="nav-sub" href="<%= l.href %>"><span class="nav-sub-text"><span class="nav-sub-title"><%= l.label %></span></span></a><% }) %>
                </div>
                <div class="nav-panel-col">
                  <strong class="nav-panel-heading">Acceso rápido</strong>
                  <% nav.shop.quick.forEach(function (l) { %><a class="nav-sub" href="<%= l.href %>"><span class="nav-sub-text"><span class="nav-sub-title"><%= l.label %></span></span></a><% }) %>
                </div>
              </div>
            </div>
          </div>
          <a class="cart-link nav-icon-link" href="<%= navEventsHref %>" aria-label="Eventos">
            <svg class="ni" width="22" height="22" aria-hidden="true"><use href="#ni-calendar"/></svg>
            <span class="cart-badge" data-count="events"><%= navEvents %></span>
          </a>
          <div class="nav-item has-submenu" data-panel="item-right">
            <a class="cart-link nav-icon-link" href="/carrito" aria-label="Carrito" aria-haspopup="true" aria-expanded="false">
              <svg class="ni" width="22" height="22" aria-hidden="true"><use href="#ni-cart"/></svg>
              <span class="cart-badge" data-count="cart"><%= navCartCount %></span>
            </a>
            <div class="nav-submenu nav-panel nav-panel--cart" aria-label="Resumen del carrito">
              <% if (navCartRows.length) { %>
              <div class="nav-cart-list">
                <% navCartRows.forEach(function (item) { %>
                <a class="nav-cart-row" href="/carrito">
                  <span class="nav-cart-qty"><%= item.qty %></span>
                  <span class="nav-sub-title"><%= item.name %></span>
                  <span class="nav-cart-price">COP <%= Number(item.total || 0).toLocaleString('es-CO') %></span>
                </a>
                <% }) %>
              </div>
              <div class="nav-cart-total"><span>Total</span><strong>COP <%= Number(navCartTotal).toLocaleString('es-CO') %></strong></div>
              <a class="nav-feature-btn" href="/carrito">Ver carrito<svg class="ni" aria-hidden="true"><use href="#ni-arrow"/></svg></a>
              <% } else { %>
              <p class="nav-cart-empty"><svg class="ni" aria-hidden="true"><use href="#ni-cart"/></svg>Tu carrito está vacío</p>
              <a class="nav-feature-btn" href="/tienda">Ir a la tienda<svg class="ni" aria-hidden="true"><use href="#ni-arrow"/></svg></a>
              <% } %>
            </div>
          </div>
          <a class="nav-cta-pill" href="/servicios/agendar" aria-label="Agendar servicio">Agendar</a>
        </div>
        <%# Barra móvil (y modo compact): logo a la izquierda, carrito y menú a la derecha %>
        <div class="mbar-actions">
          <a class="cart-link mbar-cart" href="/carrito" aria-label="Carrito">
            <svg class="ni" aria-hidden="true"><use href="#ni-cart"/></svg>
            <span class="cart-badge" data-count="cart"><%= navCartCount %></span>
          </a>
          <button class="mnav-toggle" type="button" aria-controls="mnav" aria-expanded="false" aria-label="Abrir menú">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="mnav" id="mnav" aria-label="Menú principal" inert>
        <div class="mnav-inner">
          <a class="mnav-cta" href="/servicios/agendar">Agendar servicio<svg class="ni" aria-hidden="true"><use href="#ni-arrow"/></svg></a>

          <p class="mnav-heading">Taller</p>
          <div class="mnav-acc">
            <button class="mnav-row" type="button" aria-expanded="false" aria-controls="mnav-servicios">
              <svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-wrench"/></svg><span class="mnav-label">Servicios</span><svg class="ni mnav-chev" aria-hidden="true"><use href="#ni-chev"/></svg>
            </button>
            <div class="mnav-sub" id="mnav-servicios">
              <div class="mnav-sub-inner">
                <% nav.serviceGroups.forEach(function (group) { %>
                <p class="mnav-subhead"><%= group.title %></p>
                <div class="mnav-chips">
                  <% group.items.forEach(function (it) { %><a class="mnav-chip" href="<%= it.href %>"><%= it.label %></a><% }) %>
                </div>
                <% }) %>
                <a class="mnav-all" href="/servicios">Ver todos los servicios<svg class="ni" aria-hidden="true"><use href="#ni-arrow"/></svg></a>
              </div>
            </div>
          </div>
          <a class="mnav-row" href="/cursos"><svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-book"/></svg><span class="mnav-label">Cursos</span><svg class="ni mnav-go" aria-hidden="true"><use href="#ni-arrow"/></svg></a>

          <p class="mnav-heading">Tienda</p>
          <div class="mnav-acc">
            <button class="mnav-row" type="button" aria-expanded="false" aria-controls="mnav-tienda">
              <svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-bike"/></svg><span class="mnav-label">Tienda</span><svg class="ni mnav-chev" aria-hidden="true"><use href="#ni-chev"/></svg>
            </button>
            <div class="mnav-sub" id="mnav-tienda">
              <div class="mnav-sub-inner">
                <p class="mnav-subhead">Categorías</p>
                <div class="mnav-chips">
                  <% nav.shop.categories.forEach(function (l) { %><a class="mnav-chip" href="<%= l.href %>"><%= l.label %></a><% }) %>
                </div>
                <p class="mnav-subhead">Acceso rápido</p>
                <div class="mnav-chips">
                  <% nav.shop.quick.forEach(function (l) { %><a class="mnav-chip" href="<%= l.href %>"><%= l.label %></a><% }) %>
                </div>
              </div>
            </div>
          </div>
          <a class="mnav-row" href="/carrito"><svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-cart"/></svg><span class="mnav-label">Carrito</span><span class="mnav-count" data-count="cart"><%= navCartCount %></span><svg class="ni mnav-go" aria-hidden="true"><use href="#ni-arrow"/></svg></a>

          <p class="mnav-heading">Comunidad</p>
          <a class="mnav-row" href="/club"><svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-users"/></svg><span class="mnav-label">Club</span><svg class="ni mnav-go" aria-hidden="true"><use href="#ni-arrow"/></svg></a>
          <a class="mnav-row" href="<%= navEventsHref %>"><svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-calendar"/></svg><span class="mnav-label">Eventos</span><% if (navEvents > 0) { %><span class="mnav-count" data-count="events"><%= navEvents %></span><% } %><svg class="ni mnav-go" aria-hidden="true"><use href="#ni-arrow"/></svg></a>
          <a class="mnav-row" href="/clasificados"><svg class="ni mnav-icon" aria-hidden="true"><use href="#ni-tag"/></svg><span class="mnav-label">Clasificados</span><svg class="ni mnav-go" aria-hidden="true"><use href="#ni-arrow"/></svg></a>

          <div class="mnav-foot<%= user ? ' mnav-user' : '' %>">
            <% if (user) { %>
            <p class="mnav-hello">Hola, <strong><%= user.name %></strong></p>
            <div class="mnav-foot-links">
              <a class="mnav-mini" href="/club/panel"><svg class="ni" aria-hidden="true"><use href="#ni-gauge"/></svg>Mi panel</a>
              <a class="mnav-mini" href="/club/panel#vehiculos"><svg class="ni" aria-hidden="true"><use href="#ni-bike"/></svg>Mis vehículos</a>
              <% if (user.role === 'admin') { %>
              <a class="mnav-mini" href="/admin"><svg class="ni" aria-hidden="true"><use href="#ni-shield"/></svg>Panel admin</a>
              <% } %>
              <form action="/club/logout" method="post">
                <button class="mnav-mini" type="submit"><svg class="ni" aria-hidden="true"><use href="#ni-logout"/></svg>Cerrar sesión</button>
              </form>
            </div>
            <% } else { %>
            <a class="mnav-btn mnav-btn--ghost" href="/club/login">Iniciar sesión</a>
            <a class="mnav-btn" href="/club/registro">Registro</a>
            <% } %>
          </div>
        </div>
      </nav>
      <% if (user) { %>
        <div class="sub-embed">
          <div class="sub-inner">
            <div class="sub-left">Hola, <strong>
                <%= user.name %>
              </strong>.</div>
            <nav class="sub-right">
              <% if (user && user.role==='admin' ) { %>
                <a class="sub-btn" href="/admin">Panel admin</a>
                <% } %>
                  <a class="sub-btn" href="/club/panel">Ir al panel del club</a>
                  <a class="sub-btn" href="/club/panel#vehiculos">Gestionar mis vehículos</a>
                  <a class="sub-btn"
                    href="/eventos<%= (typeof eventsFirstAnchor !== 'undefined' && eventsFirstAnchor) ? eventsFirstAnchor : '' %>">Eventos
                    <% if (typeof eventsUpcoming !=='undefined' && eventsUpcoming> 0) { %> <span class="sub-badge">
                        <%= eventsUpcoming %>
                      </span>
                      <% } %>
                  </a>
                  <form action="/club/logout" method="post" style="display:inline">
                    <button class="sub-btn" type="submit">Cerrar sesión</button>
                  </form>
            </nav>
          </div>
        </div>
        <% } %>
    </div>
  </header>
  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-toast flash-<%= flash.type %>" id="flashToast" role="alert" aria-live="polite">
    <% if (flash.type === 'success') { %>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    <% } else if (flash.type === 'error') { %>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <% } else { %>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <% } %>
    <span><%= flash.message %></span>
    <button class="flash-close" onclick="this.parentElement.remove()" aria-label="Cerrar">×</button>
  </div>
  <script>setTimeout(() => { const t = document.getElementById('flashToast'); if (t) t.remove(); }, 4000);</script>
  <% } %>

  <!-- Cart drawer -->
