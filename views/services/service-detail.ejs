<%- include('../partials/head', { title: title, extraCss: ['/static/css/taller-base.css?v=1', '/static/css/servicios.css?v=' + assetV('css/servicios.css')].concat(suggestedProducts.length ? ['/static/css/tienda.css?v=' + assetV('css/tienda.css')] : []) }) %>
<%#
  /servicios/<slug>: LA FICHA AMPLIADA
  La misma ficha de /servicios, en grande: el retazo de tablero con la
  herramienta colgada en su gancho, las cintas de rotuladora con lo que
  incluye y el texto completo. Debajo, el tablero entero con el gancho de este
  servicio vacío (su herramienta está arriba, en uso).
  Desde /servicios se llega con una transición de vista (public/js/servicios/vt.js)
  y detail.mjs imprime las cintas. Este marcado es el estado final: sin JS, sin
  soporte o con movimiento reducido se ve completo y quieto.
  Nota: head.ejs ya abre <main>; aquí no se abre otro.
%>
<%- include('../partials/servicios/tools') %>
<script src="/static/js/servicios/vt.js?v=1"></script>
<% var paragraphs = [].concat(service.details || []); %>

<div class="sv-page sv-detail-page" data-sv="detail">
  <script>
    // Antes de pintar: las cintas esperan a la rotuladora (detail.mjs). Si el
    // motion no arranca en 3 s, se destapan solas (fail-open).
    (function (d) {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('noModule' in HTMLScriptElement.prototype)) return;
        d.classList.add('sv-tapes-pending');
        window.__svTapesTimer = setTimeout(function () { d.classList.remove('sv-tapes-pending'); }, 3000);
      } catch (e) {}
    })(document.documentElement);
  </script>
  <div class="lp-wrap">

    <p class="sv-back"><a class="lp-link" href="/servicios#<%= service.slug %>"><span aria-hidden="true">&larr; </span>Todos los servicios</a></p>

    <article class="sv-card sv-detail" data-slug="<%= service.slug %>" aria-labelledby="sv-h">
      <div class="sv-card-tool sv-detail-tool" aria-hidden="true">
        <div class="sv-detail-hang">
          <span class="sv-hook"></span>
          <svg class="sv-sil" viewBox="0 0 200 120" focusable="false"><use href="#sv-t-<%= service.slug %>"/></svg>
          <svg class="sv-tool" viewBox="0 0 200 120" focusable="false" data-m><use href="#sv-t-<%= service.slug %>"/></svg>
        </div>
        <span class="sv-slot-name sv-detail-tag"><%= service.name %></span>
      </div>
      <div class="sv-card-body sv-detail-body">
        <p class="sv-num" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %> / <%= String(services.length).padStart(2, '0') %></p>
        <h1 id="sv-h" class="sv-card-title sv-detail-title"><%= service.title %></h1>
        <p class="sv-card-desc sv-detail-lead"><%= service.desc %></p>
        <% if (service.includes && service.includes.length) { %>
          <p class="sv-includes-title" id="sv-inc">Lo que hacemos</p>
          <ul class="sv-dymo-list" aria-labelledby="sv-inc">
            <% service.includes.forEach(function (t) { %><li class="sv-dymo" data-m><span><%= t %></span></li><% }) %>
          </ul>
        <% } %>
        <div class="sv-detail-text">
          <% paragraphs.forEach(function (p) { %><p><%- p %></p><% }) %>
          <p>En Gorillaz Motorbikes nos aseguramos de que tu motocicleta reciba el mejor trato posible con herramientas y personal capacitado. Agenda tu cita de <%= service.name.toLowerCase() %> de forma rápida y sencilla para que tu moto esté siempre lista para rodar.</p>
        </div>
        <% if (service.realPhoto) { %>
          <figure class="sv-card-photo">
            <img src="<%= service.realPhoto.src %>" alt="<%= service.realPhoto.alt %>" decoding="async" width="640" height="420" />
            <figcaption>Foto del taller</figcaption>
          </figure>
        <% } %>
        <% if (serviceInfo.priceFrom || serviceInfo.duration) { %>
          <dl class="sv-facts">
            <% if (serviceInfo.priceFrom) { %><div><dt>Desde</dt><dd><%= fmtCOP(serviceInfo.priceFrom) %></dd></div><% } %>
            <% if (serviceInfo.duration) { %><div><dt>Duración estimada</dt><dd><%= serviceInfo.duration %></dd></div><% } %>
          </dl>
          <p class="sv-facts-note">El valor final depende del diagnóstico de tu moto y se aprueba contigo antes de empezar.</p>
        <% } %>
        <div class="sv-card-actions">
          <a class="btn" href="/servicios/agendar?servicio=<%= encodeURIComponent(service.name) %>">Agendar <%= service.name.toLowerCase() %></a>
          <a class="btn btn-outline" href="<%= waLink(waContext) %>" target="_blank" rel="noopener">Cotizar por WhatsApp</a>
          <a class="lp-link" href="/servicios#<%= service.slug %>">Ver todos los servicios</a>
        </div>
      </div>
    </article>

    <% if (suggestedProducts.length) { %>
    <section class="sv-detail-more" aria-labelledby="sv-prod-h">
      <h2 class="sv-more-title" id="sv-prod-h">Productos para este servicio</h2>
      <p class="sv-facts-note">Cómpralos en la tienda y te los instalamos en la misma cita.</p>
      <div class="tn-grid tn-grid--row">
        <% suggestedProducts.forEach(function (p) { %><%- include('../partials/tienda/card', { p: p, price: priceOf(p) }) %><% }) %>
      </div>
    </section>
    <% } %>
    <section class="sv-detail-more" aria-labelledby="sv-more-h">
      <h2 class="sv-more-title" id="sv-more-h">Otros trabajos del taller</h2>
      <%- include('../partials/servicios/board', { services: services, current: service.slug, toDetail: true }) %>
    </section>
    <span id="sv-detail-end"></span>

  </div>
</div>

<%
  var SITE_URL = 'https://gorillazmotorbikes.com';
  var serviceLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: service.name + ' de Gorillaz Motorbikes',
      serviceType: service.name,
      description: service.desc,
      url: SITE_URL + '/servicios/' + service.slug,
      image: SITE_URL + ((service.realPhoto && service.realPhoto.src) || service.img),
      areaServed: { '@type': 'City', name: 'Bogotá' },
      offers: serviceInfo.priceFrom ? { '@type': 'Offer', priceCurrency: 'COP', priceSpecification: { '@type': 'PriceSpecification', minPrice: serviceInfo.priceFrom, priceCurrency: 'COP' } } : undefined,
      provider: { '@type': 'MotorcycleRepair', '@id': SITE_URL + '/#negocio', name: 'Gorillaz Motorbikes', url: SITE_URL + '/' }
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: SITE_URL + '/servicios' },
        { '@type': 'ListItem', position: 3, name: service.name, item: SITE_URL + '/servicios/' + service.slug }
      ]
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(serviceLd).replace(/</g, '\\u003c') %></script>

<script defer src="/static/vendor/gsap-3.15.0/gsap.min.js"></script>
<script type="module" src="/static/js/servicios/detail.mjs?v=1"></script>

<%- include('../partials/footer') %>
