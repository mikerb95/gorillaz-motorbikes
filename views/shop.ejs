<%- include('partials/head', { extraCss: ['/static/css/tienda.css?v=' + assetV('css/tienda.css')] }) %>
<%
  var products = result.products;
  var crumbsList = typeof crumbs !== 'undefined' ? crumbs : [{ name: 'Inicio', path: '/' }, { name: 'Tienda', path: '/tienda' }];
  var filtering = !!(f.q || f.brand || f.type || f.min !== null || f.max !== null || (f.bike && view !== 'bike'));
%>
<div class="tn-page">
  <%- include('partials/tienda/banner') %>
  <%- include('partials/tienda/crumbs', { crumbs: crumbsList }) %>

  <header class="tn-head">
    <div class="tn-head-text">
      <h1 class="tn-h1"><%= h1 %></h1>
      <% if (intro) { %><p class="tn-intro"><%= intro %></p><% } %>
    </div>
    <%- include('partials/tienda/mybike', { backPath: basePath }) %>
  </header>

  <% if (categories.length) { %>
  <nav class="tn-cats" aria-label="Categorías de la tienda">
    <a class="tn-cat<%= view === 'all' ? ' is-active' : '' %>" href="/tienda">Todo</a>
    <% categories.forEach(function (c) { %>
      <a class="tn-cat<%= (typeof category !== 'undefined' && category && category.slug === c.slug) ? ' is-active' : '' %>" href="/tienda/c/<%= c.slug %>"><%= c.name %> <span><%= c.count %></span></a>
    <% }) %>
  </nav>
  <% } %>

  <% if (myBike && view !== 'bike' && f.bike === myBike.slug) { var allQs = qs({ bike: '' }); %>
    <p class="tn-filter-note">Mostrando productos compatibles con tu <strong><%= myBike.brand %> <%= myBike.model %></strong>. <a href="<%= allQs %><%= allQs.indexOf('?') >= 0 ? '&' : '?' %>todas=1">Ver todos</a></p>
  <% } %>

  <div class="tn-layout">
    <aside class="tn-side">
      <details class="tn-filters" <%= filtering ? 'open' : '' %>>
        <summary>Filtrar y ordenar</summary>
        <form method="get" action="<%= basePath %>">
          <% if (view !== 'bike' && f.bike) { %><input type="hidden" name="moto" value="<%= f.bike %>" /><% } %>
          <div class="tn-field">
            <label for="tn-q">Buscar</label>
            <input id="tn-q" type="search" name="q" value="<%= f.q %>" placeholder="Producto, marca o referencia" />
          </div>
          <div class="tn-field">
            <label for="tn-sort">Ordenar por</label>
            <select id="tn-sort" name="sort">
              <% Object.keys(sorts).forEach(function (k) { %><option value="<%= k %>" <%= f.sort === k ? 'selected' : '' %>><%= sorts[k] %></option><% }) %>
            </select>
          </div>
          <% if (result.facets.bikeTypes.length > 1) { %>
          <div class="tn-field">
            <label for="tn-tipo">Tipo de moto</label>
            <select id="tn-tipo" name="tipo">
              <option value="">Todos</option>
              <% result.facets.bikeTypes.forEach(function (t) { %><option value="<%= t.slug %>" <%= f.type === t.slug ? 'selected' : '' %>><%= t.name %> (<%= t.count %>)</option><% }) %>
            </select>
          </div>
          <% } %>
          <% if (result.facets.brands.length > 1) { %>
          <div class="tn-field">
            <label for="tn-marca">Marca</label>
            <select id="tn-marca" name="marca">
              <option value="">Todas</option>
              <% result.facets.brands.forEach(function (b) { %><option value="<%= b %>" <%= f.brand === b ? 'selected' : '' %>><%= b %></option><% }) %>
            </select>
          </div>
          <% } %>
          <% if (result.priceRange.max > result.priceRange.min) { %>
          <fieldset class="tn-field tn-range">
            <legend>Precio (COP)</legend>
            <label><span class="sr-only">Desde</span><input type="number" name="min" inputmode="numeric" min="0" step="1000" value="<%= f.min !== null ? f.min : '' %>" placeholder="Desde <%= result.priceRange.min.toLocaleString('es-CO') %>" /></label>
            <label><span class="sr-only">Hasta</span><input type="number" name="max" inputmode="numeric" min="0" step="1000" value="<%= f.max !== null ? f.max : '' %>" placeholder="Hasta <%= result.priceRange.max.toLocaleString('es-CO') %>" /></label>
          </fieldset>
          <% } %>
          <div class="tn-filter-actions">
            <button class="tn-btn tn-btn--primary" type="submit">Aplicar</button>
            <% if (filtering || f.sort) { %><a class="tn-btn tn-btn--ghost" href="<%= basePath %>">Limpiar</a><% } %>
          </div>
        </form>
      </details>
    </aside>

    <section class="tn-main" aria-labelledby="tn-results">
      <p class="tn-count" id="tn-results"><%= result.total %> producto<%= result.total === 1 ? '' : 's' %><%= f.q ? ' para "' + f.q + '"' : '' %></p>

      <% if (!products.length) { %>
        <div class="tn-empty">
          <% if (view === 'bike') { %>
            <h2>Aún no tenemos productos publicados para <%= bikeModel.brand %> <%= bikeModel.model %></h2>
            <p>Escríbenos y te decimos qué podemos conseguir e instalar en el taller.</p>
          <% } else { %>
            <h2>No encontramos productos con esos filtros</h2>
            <p>Prueba con otra búsqueda o pregúntanos por WhatsApp: muchas referencias las conseguimos por encargo.</p>
          <% } %>
          <div class="tn-empty-actions">
            <a class="tn-btn tn-btn--primary" href="<%= waLink(view === 'bike' ? waMsg.bike({ model: bikeModel.brand + ' ' + bikeModel.model, url: siteUrl + basePath }) : waMsg.shop()) %>" target="_blank" rel="noopener">Preguntar por WhatsApp</a>
            <% if (filtering) { %><a class="tn-btn tn-btn--ghost" href="<%= basePath %>">Quitar filtros</a><% } %>
          </div>
        </div>
      <% } else { %>
        <div class="tn-grid">
          <% products.forEach(function (p, i) { %>
            <%- include('partials/tienda/card', { p: p, price: priceOf(p), lazy: i >= 4 }) %>
          <% }) %>
        </div>

        <% if (result.totalPages > 1) { %>
        <nav class="tn-pager" aria-label="Páginas">
          <% if (result.page > 1) { %><a rel="prev" href="<%= qs({ page: result.page - 1 }) %>">Anterior</a><% } %>
          <% for (var i = 1; i <= result.totalPages; i++) { %>
            <a href="<%= qs({ page: i }) %>" <%- i === result.page ? 'aria-current="page" class="is-active"' : '' %>><%= i %></a>
          <% } %>
          <% if (result.page < result.totalPages) { %><a rel="next" href="<%= qs({ page: result.page + 1 }) %>">Siguiente</a><% } %>
        </nav>
        <% } %>
      <% } %>

      <% if (view === 'bike' && typeof bikeServices !== 'undefined' && bikeServices.length) { %>
      <section class="tn-section">
        <h2 class="tn-h2">Servicios para tu <%= bikeModel.brand %> <%= bikeModel.model %></h2>
        <p class="tn-muted">Lo que compres aquí te lo instalamos en el taller. También hacemos el mantenimiento de tu moto.</p>
        <ul class="tn-services">
          <% bikeServices.forEach(function (s) { %>
            <li><a href="<%= s.href %>"><strong><%= s.name %></strong><span><%= s.desc %></span></a></li>
          <% }) %>
        </ul>
        <a class="tn-btn tn-btn--primary" href="/servicios/agendar">Agendar en el taller</a>
      </section>
      <% } %>

      <% if (view === 'all' && typeof bikeModels !== 'undefined' && bikeModels.length) { %>
      <section class="tn-section">
        <h2 class="tn-h2">Compra por modelo de moto</h2>
        <ul class="tn-bikes">
          <% bikeModels.forEach(function (m) { %>
            <li><a href="/tienda/moto/<%= m.slug %>"><strong><%= m.brand %> <%= m.model %></strong><span><%= m.count %> producto<%= m.count === 1 ? '' : 's' %></span></a></li>
          <% }) %>
        </ul>
      </section>
      <% } %>
    </section>
  </div>
</div>
<script defer src="/static/js/tienda.js?v=<%= assetV('js/tienda.js') %>"></script>
<%- include('partials/footer') %>
