<%- include('partials/head', { title: 'Preguntas frecuentes sobre el taller de motos', description: 'Resolvemos tus dudas sobre garantía, citas, servicios rápidos sin cita, cursos, el club y pagos en Gorillaz Motorbikes, taller de motos en Bogotá.', user }) %>

<main class="container section">
  <h1 class="section-title">Preguntas Frecuentes</h1>
  <p class="muted">Encuentra respuestas rápidas sobre nuestros servicios, club y tienda.</p>

  <div class="card" style="max-width:1000px;margin:0 auto">
    <% faq.forEach(function (f) { %>
    <details class="faq-item">
      <summary><strong><%= f.q %></strong></summary>
      <div class="faq-body">
        <%- f.a %>
      </div>
    </details>
    <% }) %>
  </div>
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué garantía tienen los servicios y productos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Todos nuestros servicios cuentan con garantía de satisfacción. Los productos tienen garantía legal y de fabricante según el tipo de artículo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen cursos o capacitaciones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, ofrecemos cursos técnicos y de conducción para todos los niveles, presenciales y virtuales."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo agendo una cita para mi moto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puedes solicitar agendamiento desde la sección Servicios en gorillazmotorbikes.com/servicios. Completa el formulario con tus datos, servicio y fecha deseada. Te contactaremos para confirmar."
      }
    },
    {
      "@type": "Question",
      "name": "¿Tienen servicios rápidos sin cita?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofrecemos mecánica rápida para cambios de aceite y ajustes menores. Puedes venir directamente o agendar para asegurar tu espacio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden preparar mi moto para la tecnomecánica?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Ofrecemos alistamiento tecnomecánico, diagnóstico y corrección de fallas para que tu moto pase la revisión sin problemas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué métodos de pago aceptan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aceptamos Nequi, Daviplata y todas las tarjetas débito y crédito en la tienda y en el taller."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacen envíos de productos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, realizamos envíos a nivel nacional. El costo y tiempo dependen del destino y se calculan en el checkout."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo obtengo o renuevo mi membresía del club?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Regístrate o inicia sesión en gorillazmotorbikes.com/club. Desde tu panel puedes ver tu estado, renovar y acceder a beneficios exclusivos."
      }
    }
  ]
}
</script>

<%- include('partials/footer') %>
