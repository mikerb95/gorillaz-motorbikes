<%- include('partials/head', { extraCss: ['/static/css/tienda.css?v=' + assetV('css/tienda.css')] }) %>
<%
  var images = product.images || [];
  var soldOut = product.stock === 0;
  var hasVariants = variants.length > 0;
  var stockText = product.stock === null ? 'Disponible' : (product.stock === 0 ? 'Agotado' : (product.stock <= 3 ? 'Últimas ' + product.stock + ' unidades' : 'Disponible'));
%>
<div class="tn-page">
  <%- include('partials/tienda/crumbs', { crumbs: crumbs }) %>
  <% if (product.status !== 'active' || (product.isDemo)) { %>
    <p class="tn-admin-note">Vista previa de administrador: este producto <%= product.isDemo ? 'es de demostración y' : '' %> no está publicado.</p>
  <% } %>

  <div class="tn-pdp">
    <div class="tn-gallery" data-gallery>
      <div class="tn-gallery-main">
        <% if (images.length) { %>
          <img src="<%= images[0].url %>" alt="<%= images[0].alt || product.name %>" width="800" height="800" fetchpriority="high" data-gallery-main />
        <% } else { %>
          <span class="tn-nophoto tn-nophoto--lg"><svg class="ni" aria-hidden="true"><use href="#ni-bike"/></svg><span>Foto del producto en preparación</span></span>
        <% } %>
        <% if (price.pct > 0) { %><span class="tn-tag tn-tag--off">-<%= price.pct %>%</span><% } %>
      </div>
      <% if (images.length > 1) { %>
      <ul class="tn-thumbs" role="list">
        <% images.forEach(function (img, i) { %>
          <li><button type="button" class="tn-thumb<%= i === 0 ? ' is-active' : '' %>" data-src="<%= img.url %>" data-alt="<%= img.alt || product.name %>" aria-label="Ver imagen <%= i + 1 %> de <%= images.length %>">
            <img src="<%= img.url %>" alt="" width="96" height="96" loading="lazy" decoding="async" />
          </button></li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <div class="tn-info">
      <% if (product.brand) { %><p class="tn-card-brand"><%= product.brand %></p><% } %>
      <h1 class="tn-pdp-title"><%= product.name %></h1>
      <p class="tn-pdp-meta">
        <% if (product.sku) { %><span>Ref. <%= product.sku %></span><% } %>
        <% if (reviews.count) { %><a href="#resenas"><span class="tn-stars" style="--r:<%= reviews.average %>" aria-hidden="true"></span><%= reviews.average.toString().replace('.', ',') %> (<%= reviews.count %> reseña<%= reviews.count === 1 ? '' : 's' %>)</a><% } %>
      </p>

      <% if (myBike) { %>
        <p class="tn-fit <%= myBikeFits ? 'is-yes' : 'is-unknown' %>">
          <% if (myBikeFits) { %><svg class="ni" aria-hidden="true"><use href="#ni-check"/></svg>Compatible con tu <%= myBike.brand %> <%= myBike.model %>
          <% } else { %>No confirmado para tu <%= myBike.brand %> <%= myBike.model %>. <a href="<%= waProduct %>" target="_blank" rel="noopener">Pregúntanos</a><% } %>
        </p>
      <% } %>

      <div class="tn-pdp-price" data-price-block>
        <strong class="tn-price-now" data-price-now><%= fmtCOP(price.final) %></strong>
        <% if (price.final < price.base) { %><s class="tn-price-was" data-price-was><%= fmtCOP(price.base) %></s><% } %>
        <% if (price.club && !price.isClubApplied) { %>
          <p class="tn-price-club"><strong>Precio club <%= fmtCOP(price.club) %></strong> <% if (!user) { %><a href="/club/registro">Únete gratis al club</a><% } %></p>
        <% } else if (price.isClubApplied) { %>
          <p class="tn-price-club"><strong>Estás viendo tu precio club</strong></p>
        <% } %>
      </div>
      <p class="tn-stock <%= soldOut ? 'is-out' : '' %>" data-stock><%= stockText %></p>

      <form class="tn-buy" data-buy-form data-product="<%= product.id %>" data-name="<%= product.name %>" data-image="<%= product.image || '' %>" action="/cart/add" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="id" value="<%= product.id %>" />
        <% if (hasVariants) { %>
          <input type="hidden" name="variant" value="" data-variant-input />
          <script type="application/json" data-variants><%- toJsonLd(variants.map(function (v) { return { id: v.id, color: v.color, size: v.size, final: v.price.final, base: v.price.base, finalText: fmtCOP(v.price.final), baseText: fmtCOP(v.price.base), stock: v.stock }; })) %></script>
          <% if (colors.length) { %>
          <fieldset class="tn-opts">
            <legend>Color</legend>
            <% colors.forEach(function (c, i) { %>
              <label class="tn-opt"><input type="radio" name="opt_color" value="<%= c %>" required /><span><%= c %></span></label>
            <% }) %>
          </fieldset>
          <% } %>
          <% if (sizes.length) { %>
          <fieldset class="tn-opts">
            <legend>Talla</legend>
            <% sizes.forEach(function (s) { %>
              <label class="tn-opt"><input type="radio" name="opt_size" value="<%= s %>" required /><span><%= s %></span></label>
            <% }) %>
          </fieldset>
          <% } %>
          <p class="tn-opts-hint" data-variant-hint>Elige <%= colors.length && sizes.length ? 'color y talla' : (colors.length ? 'un color' : 'una talla') %>.</p>
        <% } %>

        <div class="tn-qty">
          <label for="tn-qty">Cantidad</label>
          <div class="tn-qty-ctrl">
            <button type="button" data-qty="-1" aria-label="Quitar una unidad">-</button>
            <input id="tn-qty" name="qty" type="number" inputmode="numeric" min="1" max="<%= product.stock === null ? 99 : Math.max(1, product.stock) %>" value="1" />
            <button type="button" data-qty="1" aria-label="Agregar una unidad">+</button>
          </div>
        </div>

        <% if (product.installable) { %>
        <label class="tn-addon">
          <input type="checkbox" name="install" value="1" />
          <span class="tn-addon-body">
            <strong>Instalarlo en el taller</strong>
            <span><%= typeof product.installPrice === 'number' ? 'Instalación: ' + fmtCOP(product.installPrice) + ' por unidad.' : 'El valor de la instalación se confirma en el taller.' %><% if (product.installMinutes) { %> Tiempo estimado: <%= product.installMinutes %> min.<% } %> Eliges la fecha al pagar.</span>
          </span>
        </label>
        <% } %>

        <div class="tn-cta">
          <button type="submit" name="buyNow" value="1" class="tn-btn tn-btn--primary tn-btn--lg" data-buy-now <%= soldOut ? 'disabled' : '' %>>Comprar ahora</button>
          <button type="submit" class="tn-btn tn-btn--ghost tn-btn--lg" data-add-cart <%= soldOut ? 'disabled' : '' %>><svg class="ni" aria-hidden="true"><use href="#ni-cart"/></svg>Agregar al carrito</button>
        </div>
      </form>

      <ul class="tn-assure">
        <% if (deliveryMethods.length) { %><li><svg class="ni" aria-hidden="true"><use href="#ni-bike"/></svg><span><strong>Entrega:</strong> <%= deliveryMethods.join(', ') %>. <a href="/envios">Ver envíos</a></span></li><% } %>
        <% if (product.deliveryTime) { %><li><svg class="ni" aria-hidden="true"><use href="#ni-clock"/></svg><span><strong>Tiempo de entrega:</strong> <%= product.deliveryTime %></span></li><% } %>
        <li><svg class="ni" aria-hidden="true"><use href="#ni-shield"/></svg><span><strong>Garantía:</strong> <%= product.warranty || 'garantía legal según la Ley 1480 de 2011.' %> <a href="/garantias">Cómo funciona</a></span></li>
        <li><svg class="ni" aria-hidden="true"><use href="#ni-check"/></svg><span><a href="/cambios-y-devoluciones">Cambios y devoluciones</a> · <a href="/derecho-de-retracto">Derecho de retracto</a></span></li>
      </ul>

      <div class="tn-wa-row">
        <a class="tn-btn tn-btn--wa" href="<%= waProduct %>" target="_blank" rel="noopener">Preguntar por WhatsApp</a>
        <a class="tn-link" href="<%= waShare %>" target="_blank" rel="noopener">Compartir</a>
      </div>
    </div>
  </div>

  <div class="tn-details">
    <% if (product.description) { %>
    <section class="tn-detail">
      <h2 class="tn-h2">Descripción</h2>
      <% product.description.split(/\n{2,}/).forEach(function (para) { %><p><%= para %></p><% }) %>
    </section>
    <% } %>

    <% if (product.specs && product.specs.length) { %>
    <section class="tn-detail">
      <h2 class="tn-h2">Especificaciones</h2>
      <dl class="tn-specs">
        <% product.specs.forEach(function (s) { %><div><dt><%= s.label %></dt><dd><%= s.value %></dd></div><% }) %>
      </dl>
    </section>
    <% } %>

    <% if (product.includes) { %>
    <section class="tn-detail">
      <h2 class="tn-h2">Qué incluye</h2>
      <ul class="tn-list"><% product.includes.split(/\n+/).filter(Boolean).forEach(function (l) { %><li><%= l.replace(/^[-*]\s*/, '') %></li><% }) %></ul>
    </section>
    <% } %>

    <% if (compat.length || bikeTypeNames.length) { %>
    <section class="tn-detail">
      <h2 class="tn-h2">Compatibilidad</h2>
      <% if (compat.length) { %>
        <ul class="tn-compat">
          <% compat.forEach(function (c) { %><li><a href="<%= c.href %>"><strong><%= c.label %></strong><% if (c.model.cc) { %> <%= c.model.cc %> cc<% } %><% if (c.years) { %><span><%= c.years %></span><% } %></a></li><% }) %>
        </ul>
      <% } %>
      <% if (bikeTypeNames.length) { %><p class="tn-muted">Pensado para motos tipo <%= bikeTypeNames.join(', ').toLowerCase() %>.</p><% } %>
      <p class="tn-muted">¿Tu moto no aparece? <a href="<%= waProduct %>" target="_blank" rel="noopener">Pregúntanos antes de comprar</a>.</p>
    </section>
    <% } %>
  </div>

  <% if (combos.length) { %>
  <section class="tn-section">
    <h2 class="tn-h2">Ahorra en combo</h2>
    <ul class="tn-combo-links">
      <% combos.forEach(function (c) { %><li><a href="/tienda/combos#<%= c.slug %>"><strong><%= c.name %></strong><span><%= c.kind === 'kit' ? 'Kit con ' + c.kitDiscount + '% de descuento' : 'Descuento escalonado al combinar productos' %></span></a></li><% }) %>
    </ul>
  </section>
  <% } %>

  <% if (together.length) { %>
  <section class="tn-section">
    <h2 class="tn-h2">Se compran junto con este</h2>
    <div class="tn-grid tn-grid--row"><% together.forEach(function (p) { %><%- include('partials/tienda/card', { p: p, price: priceOf(p) }) %><% }) %></div>
  </section>
  <% } %>

  <% if (services.length) { %>
  <section class="tn-section">
    <h2 class="tn-h2">Servicios relacionados</h2>
    <ul class="tn-services">
      <% services.forEach(function (s) { %><li><a href="<%= s.href %>"><strong><%= s.name %></strong><span>Ver servicio y agendar</span></a></li><% }) %>
    </ul>
  </section>
  <% } %>

  <% if (related.length) { %>
  <section class="tn-section">
    <h2 class="tn-h2">También te puede servir</h2>
    <div class="tn-grid tn-grid--row"><% related.forEach(function (p) { %><%- include('partials/tienda/card', { p: p, price: priceOf(p) }) %><% }) %></div>
  </section>
  <% } %>

  <section class="tn-section tn-reviews" id="resenas">
    <h2 class="tn-h2">Reseñas de compradores</h2>
    <% if (reviews.count) { %>
      <p class="tn-reviews-sum"><span class="tn-stars" style="--r:<%= reviews.average %>" aria-hidden="true"></span><strong><%= reviews.average.toString().replace('.', ',') %> de 5</strong> · <%= reviews.count %> reseña<%= reviews.count === 1 ? '' : 's' %> verificada<%= reviews.count === 1 ? '' : 's' %></p>
      <ul class="tn-review-list">
        <% reviews.items.forEach(function (r) { %>
          <li>
            <p class="tn-review-head"><span class="tn-stars" style="--r:<%= r.rating %>" aria-label="<%= r.rating %> de 5"></span><strong><%= r.authorName %></strong> <span class="tn-muted"><%= fechaCO(r.createdAt) %></span></p>
            <p><%= r.body %></p>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="tn-muted">Este producto aún no tiene reseñas. Solo publicamos opiniones de personas que lo compraron.</p>
    <% } %>
    <details class="tn-review-form">
      <summary>¿Lo compraste? Cuéntanos qué tal</summary>
      <form method="post" action="<%= product.url %>/resena">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="tn-row">
          <div class="tn-field"><label for="rv-code">Número de pedido</label><input id="rv-code" name="orderCode" placeholder="GZ-XXXXXX" required autocomplete="off" /></div>
          <div class="tn-field"><label for="rv-email">Correo de la compra</label><input id="rv-email" name="email" type="email" required /></div>
        </div>
        <div class="tn-field"><label for="rv-name">Nombre que se mostrará</label><input id="rv-name" name="name" maxlength="60" required /></div>
        <fieldset class="tn-field tn-rate">
          <legend>Calificación</legend>
          <% [5,4,3,2,1].forEach(function (n) { %><label><input type="radio" name="rating" value="<%= n %>" required /><span><%= n %></span></label><% }) %>
        </fieldset>
        <div class="tn-field"><label for="rv-body">Tu opinión</label><textarea id="rv-body" name="body" rows="4" maxlength="1500" required></textarea></div>
        <button class="tn-btn tn-btn--primary" type="submit">Enviar reseña</button>
        <p class="tn-muted">Verificamos la compra con el número de pedido y el correo. La reseña se publica después de revisarla.</p>
      </form>
    </details>
  </section>
</div>

<div class="tn-sticky-buy" data-sticky-buy hidden>
  <span><strong><%= fmtCOP(price.final) %></strong></span>
  <button type="button" class="tn-btn tn-btn--primary" data-sticky-go <%= soldOut ? 'disabled' : '' %>><%= hasVariants ? 'Elegir opción' : 'Comprar ahora' %></button>
</div>

<script defer src="/static/js/tienda.js?v=<%= assetV('js/tienda.js') %>"></script>
<%- include('partials/footer') %>
