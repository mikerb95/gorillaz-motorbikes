<%- include('partials/head', { title: title, user, extraCss: ['/static/css/taller-base.css?v=1', '/static/css/servicios.css?v=2'] }) %>
<%#
  /servicios: "CADA TRABAJO CON SU HERRAMIENTA"
  El tablero de herramientas del taller es el índice: cada servicio es la
  herramienta con que se hace, colgada sobre su silueta pintada. Este marcado es
  el estado final y legible (sin JS o con movimiento reducido se ve completo y
  quieto); public/js/servicios/*.mjs lo anima y, si falla, devuelve lo que haya
  escondido (contrato fail-open de public/js/motion/core.mjs).
  Nota: head.ejs ya abre <main>; aquí no se abre otro.
%>
<%- include('partials/servicios/tools') %>
<%# "Ver detalle" amplía la ficha con una transición de vista (antes del contenido: ver el archivo). %>
<script src="/static/js/servicios/vt.js?v=1"></script>

<div class="sv-page" data-sv="page">
  <script>
    // Antes de pintar: la entrada del tablero (siluetas pintadas y herramientas
    // que se cuelgan) arranca desde el tablero vacío. Si el motion no arranca en
    // 3 s, todo se destapa solo (fail-open). Solo la primera vez por sesión.
    (function (d) {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('noModule' in HTMLScriptElement.prototype)) return;
        if (sessionStorage.getItem('sv-tablero')) return;
        d.classList.add('sv-enter-pending');
        window.__svEnterTimer = setTimeout(function () { d.classList.remove('sv-enter-pending'); }, 3000);
      } catch (e) {}
    })(document.documentElement);
  </script>
  <div class="lp-wrap sv-shop">

    <header class="sv-intro">
      <p class="lp-label"><%= services.length %> servicios en el taller</p>
      <h1 class="sv-title">Servicios</h1>
      <p class="sv-claim">Cada trabajo con su herramienta.</p>
      <p class="lp-lead">Especialistas en mantenimiento, performance y estética para tu moto. Calidad certificada y pasión por cada detalle.</p>
      <p class="sv-hint">Elige una herramienta del tablero para ver qué incluye su servicio.</p>
      <div class="btn-row">
        <a class="btn" href="/servicios/agendar">Agendar servicio</a>
      </div>
    </header>

    <div class="sv-board-col">
      <%- include('partials/servicios/board', { services: services }) %>
    </div>

    <div class="sv-cards">
      <% services.forEach(function (s, i) { %>
        <article class="sv-card" id="<%= s.slug %>" data-slug="<%= s.slug %>" aria-labelledby="sv-h-<%= s.slug %>">
          <div class="sv-card-tool" aria-hidden="true">
            <svg class="sv-sil" viewBox="0 0 200 120" focusable="false"><use href="#sv-t-<%= s.slug %>"/></svg>
            <svg class="sv-tool" viewBox="0 0 200 120" focusable="false" data-m><use href="#sv-t-<%= s.slug %>"/></svg>
          </div>
          <div class="sv-card-body">
            <p class="sv-num" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %> / <%= String(services.length).padStart(2, '0') %></p>
            <h2 id="sv-h-<%= s.slug %>" class="sv-card-title"><%= s.title %></h2>
            <p class="sv-card-desc"><%= s.desc %></p>
            <% if (s.includes && s.includes.length) { %>
              <p class="sv-includes-title" id="sv-inc-<%= s.slug %>">Lo que hacemos</p>
              <ul class="sv-dymo-list" aria-labelledby="sv-inc-<%= s.slug %>">
                <% s.includes.forEach(function (t) { %><li class="sv-dymo" data-m><span><%= t %></span></li><% }) %>
              </ul>
            <% } %>
            <% if (s.realPhoto) { %>
              <figure class="sv-card-photo">
                <img src="<%= s.realPhoto.src %>" alt="<%= s.realPhoto.alt %>" loading="lazy" decoding="async" width="640" height="420" />
                <figcaption>Foto del taller</figcaption>
              </figure>
            <% } %>
            <div class="sv-card-actions">
              <a class="btn" href="/servicios/agendar?servicio=<%= encodeURIComponent(s.name) %>">Agendar<span class="sr-only"> <%= s.name.toLowerCase() %></span></a>
              <a class="lp-link" href="<%= s.detailHref %>">Ver detalle<span class="sr-only"> de <%= s.name.toLowerCase() %></span><span aria-hidden="true"> &rarr;</span></a>
            </div>
          </div>
        </article>
      <% }) %>

      <div class="sv-final">
        <p class="lp-label">¿Listo?</p>
        <p class="sv-final-title">Trae tu moto al taller</p>
        <a class="btn" href="/servicios/agendar">Agendar servicio</a>
      </div>
      <span id="sv-cards-end"></span>
    </div>

  </div>
</div>

<%# Motion de /servicios (GSAP fijado y alojado en el sitio, como la home). %>
<script defer src="/static/vendor/gsap-3.15.0/gsap.min.js"></script>
<script defer src="/static/vendor/gsap-3.15.0/ScrollTrigger.min.js"></script>
<script type="module" src="/static/js/servicios/main.mjs?v=2"></script>

<%- include('partials/footer') %>
