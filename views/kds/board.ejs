<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Panel de Taller — Gorillaz</title>
  <link rel="icon" href="/favicons/favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/kds.css?v=<%= assetV('css/kds.css') %>">
  <link rel="manifest" href="/manifest-kds.webmanifest">
  <meta name="theme-color" content="#15181d">
  <meta name="color-scheme" content="dark">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script src="/static/js/kds-pwa.js?v=<%= assetV('js/kds-pwa.js') %>" defer></script>
  <script src="/static/js/kds-fullscreen.js?v=<%= assetV('js/kds-fullscreen.js') %>"></script>
</head>
<body>
  <div class="kds-top">
    <div>
      <div class="brand">Panel de Taller</div>
      <div class="who">Sesión: <%= employee.name %></div>
    </div>
    <div class="actions">
      <a class="kds-btn dark" href="/kds">Pantalla principal</a>
      <form method="post" action="/kds/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="kds-btn dark">Cambiar de mecánico</button>
      </form>
    </div>
  </div>
  <div class="kds-hazard"></div>

  <% if (flash === 'facturada') { %>
    <div class="kds-flash">✓ Orden facturada correctamente.</div>
  <% } %>

  <div class="kds-board" id="board" data-kds-board><%- boardHtml %></div>

  <a class="kds-fab" href="/kds/placa">+ Placa</a>

  <%# Datos iniciales para el módulo (firma de cambios y estados). El reemplazo
      de "<" evita que un dato cierre la etiqueta <script>. %>
  <script type="application/json" id="kdsBoardData"><%- JSON.stringify({ statuses: EMP_STATUS, orders: orders }).replace(/</g, '\\u003c') %></script>

  <%# El tablero se actualiza solo (polling) y anima los cambios con Flip. El
      repintado funciona aunque GSAP no cargue; solo se pierde la animación. %>
  <script defer src="/static/js/kds/board-markup.js?v=<%= assetV('js/kds/board-markup.js') %>"></script>
  <script defer src="/static/vendor/gsap-3.15.0/gsap.min.js"></script>
  <script defer src="/static/vendor/gsap-3.15.0/Flip.min.js"></script>
  <script type="module" src="/static/js/kds/board.mjs?v=<%= assetV('js/kds/board.mjs') %>"></script>
</body>
</html>
